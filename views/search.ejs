<%- include('partials/shell-top') %>
<%#
  Search (Figma W06) with the task filters (W21). The query is the header's search box (form#search-form), and the
  filter fields join that form with form="search-form"; app.js swaps in each [data-live] part as you type or tick.
  Locals: searchQuery, search (parseSearch), filtered, tasks, maxResults, highlight (the typed words, marked in each
  title), priorities, statuses, dues.
%>
<%
  const resetHref = '/search' + (search.q ? `?q=${encodeURIComponent(search.q)}` : '');
  const capitalise = (word) => word[0].toUpperCase() + word.slice(1);
  const projectChoices = sidebarProjects.map((project) => ({ value: project.id ?? 'inbox', label: project.name, colour: project.colour }));
  const tz = currentUser.timeZone;
  const day = (date) => (date ? dates.formatDay(dates.zonedTime({ ...dates.parseDateInput(date), hour: 12 }, tz), tz) : '…');
  const dueLabel = search.due === 'range' ? `${day(search.from)} – ${day(search.to)}` : dues[search.due];
  const active = [
    ...projectChoices.filter((choice) => search.projects.includes(choice.value)).map((choice) => choice.label),
    ...search.priorities.map(capitalise),
    ...search.statuses.map((status) => statuses[status]),
    ...(search.due ? [dueLabel] : []),
  ];
%>
<% function chip(type, name, value, label, checked, colour) { %>
  <label class="inline-flex h-9 cursor-pointer items-center gap-1.5 rounded-full border border-base-300 px-3 text-sm pointer-coarse:h-11 has-[:checked]:border-primary has-[:checked]:bg-primary has-[:checked]:text-primary-content has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-primary">
    <input type="<%= type %>" name="<%= name %>" value="<%= value %>" form="search-form" class="sr-only" <%= checked ? 'checked' : '' %>>
    <% if (colour !== undefined) { %><span class="size-2 rounded-full <%= colour ? '' : 'bg-base-300' %>" <% if (colour) { %>style="background-color: <%= colour %>"<% } %> aria-hidden="true"></span><% } %>
    <%= label %>
  </label>
<% } %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-3xl font-bold tracking-tight">Search</h1>
  <details class="dropdown dropdown-end" data-dismissable>
    <summary class="btn h-11 list-none rounded-full border-0 bg-fill px-5">Filter</summary>
    <div class="group dropdown-content z-20 mt-2 w-[min(24rem,calc(100vw-2rem))] space-y-4 rounded-box border border-base-300 bg-base-100 p-4 shadow-lg">
      <div class="flex items-center justify-between">
        <h2 class="font-semibold">Filter tasks</h2>
        <a href="<%= resetHref %>" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline" data-search-reset>Reset filters</a>
      </div>
      <fieldset>
        <legend class="mb-2 text-xs font-semibold text-muted uppercase">Project</legend>
        <div class="flex flex-wrap gap-2"><% projectChoices.forEach((choice) => chip('checkbox', 'project', choice.value, choice.label, search.projects.includes(choice.value), choice.colour)) %></div>
      </fieldset>
      <fieldset>
        <legend class="mb-2 text-xs font-semibold text-muted uppercase">Priority</legend>
        <div class="flex flex-wrap gap-2"><% [...priorities].reverse().forEach((priority) => chip('checkbox', 'priority', priority, capitalise(priority), search.priorities.includes(priority))) %></div>
      </fieldset>
      <fieldset>
        <legend class="mb-2 text-xs font-semibold text-muted uppercase">Status</legend>
        <div class="flex flex-wrap gap-2"><% Object.entries(statuses).forEach(([status, label]) => chip('checkbox', 'status', status, label, search.statuses.includes(status))) %></div>
      </fieldset>
      <fieldset>
        <legend class="mb-2 text-xs font-semibold text-muted uppercase">Due</legend>
        <div class="flex flex-wrap gap-2">
          <% chip('radio', 'due', '', 'Any time', !search.due) %>
          <% Object.entries(dues).forEach(([due, label]) => chip('radio', 'due', due, label, search.due === due)) %>
        </div>
        <%# The two dates show while "Pick dates" is ticked (CSS :has, no script). %>
        <div class="mt-3 hidden grid-cols-2 gap-2 group-has-[[value=range]:checked]:grid">
          <div>
            <label for="filter-from" class="mb-1.5 block text-xs font-semibold">From</label>
            <input id="filter-from" name="from" type="date" form="search-form" value="<%= search.from %>" class="input h-11 w-full">
          </div>
          <div>
            <label for="filter-to" class="mb-1.5 block text-xs font-semibold">To</label>
            <input id="filter-to" name="to" type="date" form="search-form" value="<%= search.to %>" class="input h-11 w-full">
          </div>
        </div>
      </fieldset>
      <div class="flex justify-end">
        <button type="submit" form="search-form" class="btn btn-primary h-11 rounded-full px-5">Show tasks</button>
      </div>
    </div>
  </details>
</div>

<p class="sr-only" aria-live="polite" data-search-status></p>

<div class="mt-3 flex min-h-11 flex-wrap items-center gap-2 text-sm" data-live="chips">
  <% if (active.length) { %>
    <span class="text-muted">Showing:</span>
    <% active.forEach((label) => { %><span class="rounded-full bg-primary px-3 py-1 text-primary-content"><%= label %></span><% }) %>
    <a href="<%= resetHref %>" class="inline-flex min-h-11 items-center px-1 font-semibold text-primary hover:underline">Reset</a>
  <% } %>
</div>

<div class="mt-3" data-live="results">
  <% if (!searchQuery && !filtered) { %>
    <%- include('partials/empty-state', { icon: 'search', heading: 'Search your tasks', text: 'Type in the search box above, or pick filters. Titles and descriptions both count.' }) %>
  <% } else if (!tasks.length) { %>
    <%- include('partials/empty-state', { icon: 'search', heading: searchQuery ? `Nothing matches “${searchQuery}”` : 'No tasks match these filters', text: filtered ? 'Try fewer words or filters.' : 'Check the spelling, or try fewer words.' }) %>
  <% } else { %>
    <p class="text-sm text-muted" data-summary>
      <%= tasks.length %> <%= searchQuery ? (tasks.length === 1 ? 'task matches' : 'tasks match') : (tasks.length === 1 ? 'task' : 'tasks') %><%= searchQuery ? ` “${searchQuery}”` : '' %><%= tasks.length === maxResults ? ` (the first ${maxResults})` : '' %>
    </p>
    <ul class="mt-3 divide-y divide-base-300 overflow-hidden rounded-box bg-base-100">
      <% tasks.forEach((task) => { %><%- include('tasks/_row', { task, timeZone: currentUser.timeZone, showProject: true, highlight }) %><% }) %>
    </ul>
  <% } %>
</div>
<%- include('partials/shell-bottom') %>
