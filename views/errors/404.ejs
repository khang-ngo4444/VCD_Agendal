<%# Any unknown address (Figma AD-W05 / AD-M05). Non-admins see this for /admin too. %>
<%- include('../partials/header') %>
<main class="flex min-h-screen flex-col bg-base-200 px-4">
  <a href="/" class="mt-6 flex items-center gap-2.5 self-start text-lg font-bold lg:ml-6">
    <span class="grid size-8 place-items-center rounded-lg bg-neutral text-neutral-content">
      <%- include('../partials/icon', { icon: 'check', cls: 'size-4' }) %>
    </span>
    Agendal
  </a>
  <div class="m-auto flex max-w-sm flex-col items-center py-16 text-center">
    <p class="text-8xl font-bold text-muted/60 tabular-nums" aria-hidden="true">404</p>
    <h1 class="mt-2 text-2xl font-bold tracking-tight">Page not found</h1>
    <p class="mt-2 text-sm text-muted">The page you’re looking for doesn’t exist or has moved.</p>
    <a href="<%= locals.currentUser ? '/today' : '/' %>" class="btn btn-primary mt-6 h-11 rounded-full px-6"><%= locals.currentUser ? 'Back to Today' : 'Go to the home page' %></a>
  </div>
</main>
<%- include('../partials/footer') %>
