<%- include('partials/shell-top') %>
<%# Insights (Figma W14). Locals: what services/insights.js loadInsights returns, plus chartType. Every chart has its numbers in a
    table for screen readers; only the 30-day chart needs JavaScript. %>
<%
  const label = (day, options) => new Intl.DateTimeFormat('en-GB', { ...options, timeZone: 'UTC' }).format(new Date(`${day}T12:00:00Z`));
  const lastDay = dates.addDays(range.to, -1);
  const rangeText = period === 'month' ? label(range.from, { month: 'long', year: 'numeric' })
    : `${label(range.from, { day: 'numeric', month: 'short' })} – ${label(lastDay, { day: 'numeric', month: 'short', ...(period === 'semester' ? { year: 'numeric' } : {}) })}`;
  const versus = { week: 'last week', month: 'last month', semester: 'the 20 weeks before' }[period];
  // Focus time: minutes under an hour, then hours with one decimal ("9.5 h", "2 h").
  const focusAmount = (minutes) => (minutes < 60 ? { value: minutes, unit: 'min' } : { value: String(Math.round(minutes / 6) / 10), unit: 'h' });
  const pct = (part, whole) => (whole ? Math.round((part / whole) * 100) : 0);
  // "↑ 3 vs last week" in words as well as colour (WCAG 1.4.1); unit is '' for counts or ' points' for percentages.
  const delta = (value, unit = '') => value == null ? { text: `Nothing to compare with ${versus}`, tone: 'text-muted' }
    : value === 0 ? { text: `Same as ${versus}`, tone: 'text-muted' }
    : { text: `${value > 0 ? '↑' : '↓'} ${Math.abs(value)}${unit} vs ${versus}`, tone: value > 0 ? 'text-success' : 'text-error' };
  const rings = [
    { key: 'tasks', label: 'Tasks today', done: todayProgress.tasks.done, total: todayProgress.tasks.total, href: '/today', tone: 'var(--color-success)' },
    { key: 'habits', label: 'Habits today', done: todayProgress.habits.done, total: todayProgress.habits.total, href: '/habits', tone: 'var(--color-primary)' },
  ];
  const trendMax = Math.max(1, ...trend.tasks.map((d) => d.count), ...trend.checkIns.map((d) => d.count));
  const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;
  const trendTotal = { tasks: trend.tasks.reduce((s, d) => s + d.count, 0), checkIns: trend.checkIns.reduce((s, d) => s + d.count, 0) };
  const projectMax = Math.max(1, ...projects.map((p) => p.total));
  const sortLink = (key) => `?period=${period}&sort=${key}#habits-heading`;
%>
<div class="insights">
<header class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-xs font-semibold tracking-wide text-primary uppercase"><%= rangeText %></p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight">Insights</h1>
    <p class="mt-1 text-sm text-muted">Compared with <%= versus %> · times in your time zone (<%= currentUser.timeZone %>)</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%# Week / Month / Semester: plain links, so the choice is in the address and Back works %>
    <nav class="flex rounded-full bg-fill p-1" aria-label="Period">
      <% [['week', 'Week'], ['month', 'Month'], ['semester', 'Semester']].forEach(([key, text]) => { %>
        <a href="?period=<%= key %>&sort=<%= sort %>" class="inline-flex min-h-9 items-center rounded-full px-4 text-sm font-medium <%= period === key ? 'bg-base-100 shadow-sm' : 'text-muted hover:text-base-content' %>"
          <% if (period === key) { %>aria-current="page"<% } %>><%= text %></a>
      <% }) %>
    </nav>
    <details class="dropdown dropdown-end" data-dismissable>
      <summary class="btn h-11 gap-2 rounded-full border-0 bg-fill px-4 font-medium">
        <%- include('partials/icon', { icon: 'inbox', cls: 'size-4' }) %> Export
      </summary>
      <ul class="dropdown-content z-30 mt-2 w-64 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
        <li><a href="/insights/export/tasks.csv" download class="flex min-h-11 flex-col justify-center rounded-field px-3 hover:bg-base-200">
          <span class="text-sm font-medium">Tasks (.csv)</span><span class="text-xs text-muted">Every task, with its dates and project</span></a></li>
        <li><a href="/insights/export/habit-checkins.csv" download class="flex min-h-11 flex-col justify-center rounded-field px-3 hover:bg-base-200">
          <span class="text-sm font-medium">Habit check-ins (.csv)</span><span class="text-xs text-muted">One row per habit per day checked in</span></a></li>
      </ul>
    </details>
  </div>
</header>

<%# Headline numbers for the period (W14 top row) %>
<ul class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="This <%= period %> at a glance">
  <% const done = delta(doneChange); const rate = delta(rateChange, ' points'); %>
  <li class="rounded-box bg-base-100 p-5">
    <p class="text-sm text-muted">Tasks completed</p>
    <p class="mt-1 text-4xl font-bold tabular-nums"><%= rates.current.done %> <span class="text-base font-normal text-muted">of <%= rates.current.due %> due</span></p>
    <p class="mt-1 text-xs font-medium <%= done.tone %>"><%= done.text %></p>
  </li>
  <li class="rounded-box bg-base-100 p-5">
    <p class="text-sm text-muted">Completion rate</p>
    <p class="mt-1 text-4xl font-bold tabular-nums"><%= rates.current.rate ?? '–' %><span class="text-base font-normal text-muted"><%= rates.current.rate == null ? '' : ' %' %></span></p>
    <p class="mt-1 text-xs font-medium <%= rate.tone %>"><%= rates.current.rate == null ? `Nothing due this ${period} yet` : rate.text %></p>
  </li>
  <li class="rounded-box bg-base-100 p-5">
    <p class="text-sm text-muted">Done on time</p>
    <p class="mt-1 text-4xl font-bold tabular-nums"><%= rates.current.onTime ?? '–' %><span class="text-base font-normal text-muted"><%= rates.current.onTime == null ? '' : ' %' %></span></p>
    <p class="mt-1 text-xs text-muted">Of the tasks done, finished by their due date</p>
  </li>
  <%# Focus time: finished focus blocks only, so it is time really spent on tasks %>
  <% const focusNow = focusAmount(focus.current); const focusDelta = focus.change ? focusAmount(Math.abs(focus.change)) : null; %>
  <li class="rounded-box bg-base-100 p-5">
    <p class="text-sm text-muted">Focus time</p>
    <p class="mt-1 text-4xl font-bold tabular-nums"><%= focusNow.value %> <span class="text-base font-normal text-muted"><%= focusNow.unit %></span></p>
    <p class="mt-1 text-xs font-medium <%= !focus.change ? 'text-muted' : focus.change > 0 ? 'text-success' : 'text-error' %>">
      <% if (focus.change == null) { %><a href="/focus" class="hover:underline">Start a focus block</a> to see it here<% } else if (!focus.change) { %>Same as <%= versus %><% } else { %><%= focus.change > 0 ? '↑' : '↓' %> <%= focusDelta.value %> <%= focusDelta.unit %> vs <%= versus %><% } %>
    </p>
  </li>
</ul>

<div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,1fr)_380px]">
  <%# Today: the same counts as the Daily List (card: "Statistics page: today's overview"). Three tiles that fill the card
      (it is as tall as Tasks by project beside it), then the day as a whole: tasks and habits done out of all of them. %>
  <%
    const overall = { done: todayProgress.tasks.done + todayProgress.habits.done, total: todayProgress.tasks.total + todayProgress.habits.total };
    const overallPct = pct(overall.done, overall.total);
    const tileClass = 'flex h-full flex-col items-center justify-between gap-3 rounded-box p-4 text-center transition-colors';
  %>
  <section class="flex flex-col rounded-box bg-base-100 p-6" aria-labelledby="today-heading">
    <div class="flex items-baseline justify-between gap-2">
      <h2 id="today-heading" class="font-semibold">Today</h2>
      <a href="/today" class="text-sm font-medium text-primary hover:underline">Open Daily List</a>
    </div>
    <ul class="mt-4 grid grow grid-cols-3 gap-2 sm:gap-3">
      <% rings.forEach((ring) => { const p = pct(ring.done, ring.total); %>
        <li>
          <a href="<%= ring.href %>" class="<%= tileClass %> bg-fill hover:bg-base-300/70">
            <span class="text-sm font-semibold"><%= ring.label %></span>
            <%# The ring as SVG: a grey track and the done share on top, so it works on any tile colour %>
            <span class="relative grid size-20 place-items-center sm:size-24" role="progressbar" aria-valuenow="<%= p %>" aria-valuemin="0" aria-valuemax="100"
              aria-label="<%= ring.label %>: <%= ring.done %> of <%= ring.total %> done">
              <svg viewBox="0 0 36 36" class="absolute inset-0 size-full -rotate-90" aria-hidden="true">
                <circle cx="18" cy="18" r="15.5" fill="none" stroke-width="3.5" class="stroke-base-300"></circle>
                <% if (p) { %><circle cx="18" cy="18" r="15.5" fill="none" stroke-width="3.5" stroke-linecap="round" pathLength="100" stroke-dasharray="<%= p %> 100" style="stroke: <%= ring.tone %>"></circle><% } %>
              </svg>
              <span class="text-lg font-bold tabular-nums sm:text-xl"><%= ring.done %><span class="text-muted">/<%= ring.total %></span></span>
            </span>
            <span class="text-xs text-muted"><%= !ring.total ? 'Nothing planned' : ring.done === ring.total ? 'All done' : `${ring.total - ring.done} to go` %></span>
          </a>
        </li>
      <% }) %>
      <li>
        <a href="/today" class="<%= tileClass %> <%= todayProgress.overdue ? 'bg-error/10 hover:bg-error/15' : 'bg-fill hover:bg-base-300/70' %>">
          <span class="text-sm font-semibold">Overdue</span>
          <span class="grid size-20 place-items-center rounded-full border-[5px] sm:size-24 sm:border-[6px] <%= todayProgress.overdue ? 'border-error text-error' : 'border-base-300' %> text-2xl font-bold tabular-nums sm:text-3xl"
            aria-label="<%= todayProgress.overdue %> overdue"><%= todayProgress.overdue %></span>
          <span class="text-xs <%= todayProgress.overdue ? 'font-medium text-error' : 'text-muted' %>"><%= todayProgress.overdue ? 'Past their due date' : 'Nothing late' %></span>
        </a>
      </li>
    </ul>
    <div class="mt-4">
      <div class="flex items-baseline justify-between gap-2 text-xs">
        <span class="font-medium">Today overall</span>
        <span class="text-muted tabular-nums"><%= overall.total ? `${overall.done} of ${overall.total} done · ${overallPct}%` : 'Nothing planned for today' %></span>
      </div>
      <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-base-300" role="progressbar" aria-valuenow="<%= overallPct %>" aria-valuemin="0" aria-valuemax="100" aria-label="Today overall: <%= overall.done %> of <%= overall.total %> done">
        <div class="h-full rounded-full bg-success" style="width: <%= overallPct %>%"></div>
      </div>
    </div>
  </section>

  <%# Open and done tasks per project, in the project colours; matches the sidebar counts %>
  <section class="rounded-box bg-base-100 p-6" aria-labelledby="projects-heading">
    <h2 id="projects-heading" class="font-semibold">Tasks by project</h2>
    <ul class="mt-4 space-y-4">
      <% projects.forEach((project, i) => { %>
        <li>
          <a href="<%= project.href %>" class="block rounded-field hover:bg-base-200 -mx-2 px-2 py-1">
            <span class="flex items-center justify-between text-sm">
              <span class="flex items-center gap-2 font-medium"><span class="size-2.5 rounded-full <%= project.colour ? '' : 'bg-base-300' %>" <% if (project.colour) { %>style="background-color: <%= project.colour %>"<% } %> aria-hidden="true"></span><%= project.name %></span>
              <span class="text-muted tabular-nums"><%= project.done %> done · <%= project.open %> open</span>
            </span>
            <%# Done in the project colour, open as its tint; the bar's length is the project's share of the biggest one %>
            <span class="mt-1.5 flex h-2 overflow-hidden rounded-full bg-fill" style="width: <%= Math.max(4, pct(project.total, projectMax)) %>%" aria-hidden="true">
              <span class="grow-x h-full <%= project.colour ? '' : 'bg-muted' %>" style="--i: <%= i %>; width: <%= pct(project.done, project.total) %>%; <%= project.colour ? `background-color: ${project.colour}` : '' %>"></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
    <div class="sr-only">
      <table>
        <caption>Tasks by project</caption>
        <thead><tr><th scope="col">Project</th><th scope="col">Done</th><th scope="col">Open</th></tr></thead>
        <tbody><% projects.forEach((p) => { %><tr><td><%= p.name %></td><td><%= p.done %></td><td><%= p.open %></td></tr><% }) %></tbody>
      </table>
    </div>
  </section>
</div>

<%# Last 30 days (card: "Productivity trend chart", Figma W14 v2): tasks completed and habit check-ins per day, as bars or
    lines (saved to the account). public/js/insights.js draws it with Chart.js; without JavaScript the plain bars below
    stay, and the numbers are always in the table for screen readers. %>
<section class="mt-5 rounded-box bg-base-100 p-6" aria-labelledby="trend-heading" data-trend>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="trend-heading" class="font-semibold">Last 30 days</h2>
    <form method="post" action="/insights/chart" class="flex rounded-full bg-fill p-1" data-chart-type>
      <%- include('partials/csrf') %>
      <input type="hidden" name="returnTo" value="<%= currentUrl %>">
      <% [['bar', 'Bars'], ['line', 'Lines']].forEach(([key, text]) => { %>
        <button type="submit" name="chart" value="<%= key %>" aria-pressed="<%= chartType === key %>"
          class="inline-flex min-h-9 items-center rounded-full px-4 text-sm font-medium <%= chartType === key ? 'bg-base-100 shadow-sm' : 'text-muted hover:text-base-content' %>"><%= text %></button>
      <% }) %>
    </form>
  </div>
  <%# Legend: buttons that show or hide a series (they work once the chart script runs) %>
  <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Series">
    <% [[0, 'bg-primary', `${plural(trendTotal.tasks, 'task')} completed`], [1, 'bg-success', plural(trendTotal.checkIns, 'habit check-in')]].forEach(([i, tone, text]) => { %>
      <button type="button" data-series="<%= i %>" aria-pressed="true"
        class="inline-flex min-h-9 items-center gap-2 rounded-full border border-base-300 px-3 text-sm font-medium aria-[pressed=false]:text-muted aria-[pressed=false]:opacity-60">
        <span class="size-2.5 rounded-full <%= tone %>" aria-hidden="true"></span><%= text %>
      </button>
    <% }) %>
  </div>

  <div class="relative mt-4 h-64" data-chart hidden>
    <canvas id="trend-chart" tabindex="0" role="img" class="rounded-field focus-visible:outline-2 focus-visible:outline-primary"
      aria-label="Tasks completed and habit check-ins per day over the last 30 days. Use the left and right arrow keys to read each day."></canvas>
  </div>
  <script type="application/json" id="trend-data"><%- JSON.stringify({
    type: chartType,
    labels: trend.tasks.map((d, i) => i === trend.tasks.length - 1 ? 'Today' : label(d.date, { day: 'numeric', month: 'short' })),
    days: trend.tasks.map((d) => label(d.date, { weekday: 'short', day: 'numeric', month: 'short' })),
    tasks: trend.tasks.map((d) => d.count),
    checkIns: trend.checkIns.map((d) => d.count),
  }).replace(/</g, '\\u003c') %></script>

  <%# Without JavaScript: the two numbers per day as plain bars, the day's numbers in each column's title %>
  <div class="mt-4" data-chart-fallback>
    <div class="flex h-48 items-end gap-px border-b border-base-300">
      <% trend.tasks.forEach((day, i) => { %>
        <div class="flex h-full flex-1 items-end justify-center gap-px" title="<%= label(day.date, { weekday: 'short', day: 'numeric', month: 'short' }) %> · <%= plural(day.count, 'task') %> · <%= plural(trend.checkIns[i].count, 'check-in') %>">
          <span class="w-1/3 max-w-2 rounded-t-sm bg-primary" style="height: <%= (day.count / trendMax) * 100 %>%"></span>
          <span class="w-1/3 max-w-2 rounded-t-sm bg-success" style="height: <%= (trend.checkIns[i].count / trendMax) * 100 %>%"></span>
        </div>
      <% }) %>
    </div>
    <div class="mt-2 flex justify-between text-xs text-muted" aria-hidden="true">
      <span><%= label(trend.tasks[0].date, { day: 'numeric', month: 'short' }) %></span><span class="font-medium text-primary">Today</span>
    </div>
  </div>
  <% if (!trendTotal.tasks && !trendTotal.checkIns) { %><p class="mt-3 text-sm text-muted">Nothing completed in the last 30 days yet. Finish a task or check in a habit and it shows up here.</p><% } %>
  <div class="sr-only">
    <table>
      <caption>Tasks completed and habit check-ins per day, last 30 days</caption>
      <thead><tr><th scope="col">Day</th><th scope="col">Tasks completed</th><th scope="col">Habit check-ins</th></tr></thead>
      <tbody><% trend.tasks.forEach((day, i) => { %><tr><td><%= label(day.date, { day: 'numeric', month: 'short' }) %></td><td><%= day.count %></td><td><%= trend.checkIns[i].count %></td></tr><% }) %></tbody>
    </table>
  </div>
</section>

<%#
  Semester activity (card: "Semester activity heatmap", Figma W14): tasks done per day for the last 20 weeks, one column
  per week. Shades are classes written out in full so Tailwind keeps them. The grid is decorative for screen readers;
  the weekly totals are in a table instead.
%>
<%
  const SHADES = ['bg-base-300', 'bg-primary/30', 'bg-primary/55', 'bg-primary/80', 'bg-primary'];
  const dayName = (day) => label(day, { weekday: 'short', day: 'numeric', month: 'short' });
  const monthAt = new Map(semester.months.map(({ month, column }) => [column, label(`${month}-01`, { month: 'short' })]));
%>
<div class="mt-5">
  <section class="min-w-0 rounded-box bg-base-100 p-6" aria-labelledby="semester-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h2 id="semester-heading" class="font-semibold">Semester activity</h2>
      <p class="text-sm text-muted"><%= plural(semester.total, 'task') %> done since <%= label(semester.from, { day: 'numeric', month: 'short' }) %></p>
    </div>
    <%# rtl on the scroller only: on narrow screens it opens scrolled to the latest weeks %>
    <div class="mt-4 overflow-x-auto pb-1 [direction:rtl]" aria-hidden="true">
      <div class="grid w-max grid-cols-[1.5rem_repeat(20,0.75rem)] gap-[3px] [direction:ltr] text-[11px] text-muted sm:w-full sm:grid-cols-[2rem_repeat(20,minmax(0,1fr))] sm:gap-1">
        <span></span>
        <% semester.weeks.forEach((week, w) => { %><span class="whitespace-nowrap"><%= monthAt.get(w) ?? '' %></span><% }) %>
        <% for (let d = 0; d < 7; d++) { %>
          <span class="self-center leading-3"><%= d % 2 === 0 && d < 6 ? label(semester.weeks[0][d].date, { weekday: 'short' }) : '' %></span>
          <% semester.weeks.forEach((week) => { const day = week[d]; %>
            <%# data-heat-*: the instant tooltip (public/js/insights.js); title is the fallback without JavaScript %>
            <span class="aspect-square rounded-[3px] sm:rounded <%= day.future ? 'border border-dashed border-base-300' : `${SHADES[day.level]} hover:outline-2 hover:outline-offset-1 hover:outline-base-content/70` %>"
              <% if (!day.future) { %>data-heat-count="<%= plural(day.count, 'task') %>" data-heat-day="<%= label(day.date, { weekday: 'long', day: 'numeric', month: 'long' }) %>"
              title="<%= dayName(day.date) %>: <%= plural(day.count, 'task') %>"<% } %>></span>
          <% }) %>
        <% } %>
      </div>
    </div>
    <div class="pointer-events-none fixed z-50 -translate-x-1/2 -translate-y-full rounded-field bg-neutral px-3 py-2 text-sm whitespace-nowrap text-neutral-content shadow-lg" role="tooltip" data-heat-tip hidden>
      <span data-heat-tip-text></span>
      <span class="absolute top-full left-1/2 -translate-x-1/2 border-x-[6px] border-t-[6px] border-x-transparent border-t-neutral" aria-hidden="true"></span>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
      <span class="inline-flex items-center gap-1" aria-hidden="true">Less
        <% SHADES.forEach((shade) => { %><span class="size-3 rounded-[3px] <%= shade %>"></span><% }) %> More</span>
      <span><%= semester.busiest ? `Busiest day: ${dayName(semester.busiest.date)} · ${plural(semester.busiest.count, 'task')}` : 'No tasks finished yet this semester' %></span>
    </div>
    <%# sr-only on a wrapper, not on the table: a table won't shrink to 1 px, and a 500 px invisible table made the page
        longer than its content (the jump at the bottom) and let the caption show %>
    <div class="sr-only"><table>
      <caption>Tasks done per week, last 20 weeks</caption>
      <thead><tr><th scope="col">Week of</th><th scope="col">Tasks done</th></tr></thead>
      <tbody>
        <% semester.weeks.forEach((week) => { %>
          <tr><td><%= label(week[0].date, { day: 'numeric', month: 'long' }) %></td><td><%= week.reduce((sum, day) => sum + day.count, 0) %></td></tr>
        <% }) %>
      </tbody>
    </table></div>
  </section>
</div>

<%# Habit streaks (card: "Habit streaks overview"): the same numbers as each habit's page, sortable by column %>
<section class="mt-5 rounded-box bg-base-100 p-6" aria-labelledby="habits-heading">
  <div class="flex items-baseline justify-between gap-2">
    <h2 id="habits-heading" class="font-semibold">Habit streaks</h2>
    <a href="/habits" class="text-sm font-medium text-primary hover:underline">All habits</a>
  </div>
  <% if (!habits.length) { %>
    <p class="mt-4 text-sm text-muted">No habits yet. <a href="/habits/new" class="font-medium text-primary hover:underline">Create one</a> to track a streak.</p>
  <% } else { %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-base-300 text-left text-xs text-muted">
            <th scope="col" class="py-2 pr-4 font-medium">Habit</th>
            <% [['current', 'Current streak'], ['longest', 'Longest streak'], ['rate', 'Last 30 days']].forEach(([key, text]) => { %>
              <th scope="col" class="py-2 pr-4 text-right font-medium" aria-sort="<%= sort === key ? 'descending' : 'none' %>">
                <a href="<%= sortLink(key) %>" class="inline-flex min-h-9 items-center gap-1 hover:text-base-content <%= sort === key ? 'font-semibold text-base-content' : '' %>"><%= text %><% if (sort === key) { %> ↓<% } %></a>
              </th>
            <% }) %>
          </tr>
        </thead>
        <tbody>
          <% habits.forEach((row) => { %>
            <tr class="border-b border-base-300 last:border-0">
              <td class="py-3 pr-4"><a href="/habits/<%= row.id %>" class="flex items-center gap-2 font-medium hover:underline"><span class="size-2.5 shrink-0 rounded-full" style="background-color: <%= row.colour %>" aria-hidden="true"></span><%= row.name %></a></td>
              <td class="py-3 pr-4 text-right tabular-nums"><%= row.current %> <%= row.unit %><%= row.current === 1 ? '' : 's' %></td>
              <td class="py-3 pr-4 text-right tabular-nums"><%= row.longest %> <%= row.unit %><%= row.longest === 1 ? '' : 's' %></td>
              <td class="py-3 pr-4 text-right tabular-nums"><%= row.rate == null ? '–' : `${row.rate}%` %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
</div>
<script src="/js/vendor/chart.umd.min.js" defer></script>
<script src="/js/insights.js" defer></script>
<%- include('partials/shell-bottom') %>
