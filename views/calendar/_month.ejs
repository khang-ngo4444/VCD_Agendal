<%# Month layout: whole weeks, the days of other months dimmed. A day's number opens it in the day layout. %>
<section class="overflow-hidden rounded-box bg-base-100" aria-label="<%= heading %>">
  <div class="grid grid-cols-7 border-b border-base-300 text-xs font-semibold text-muted" aria-hidden="true">
    <% days.slice(0, 7).forEach((day) => { %><span class="px-2 py-2"><%= day.weekday %></span><% }) %>
  </div>
  <ol class="grid grid-cols-7">
    <% days.forEach((day, i) => { %>
      <li class="min-h-28 border-base-300 p-1.5 <%= i % 7 ? 'border-l' : '' %> <%= i >= 7 ? 'border-t' : '' %> <%= day.inMonth ? '' : 'bg-base-200/50' %>" data-day="<%= day.date %>">
        <a href="?view=day&date=<%= day.date %>" class="grid size-7 place-items-center rounded-full text-sm tabular-nums hover:bg-base-200
          <%= day.isToday ? 'bg-primary font-semibold text-primary-content hover:bg-primary' : day.inMonth ? '' : 'text-muted' %>" aria-label="<%= day.name %>"><%= day.number %></a>
      </li>
    <% }) %>
  </ol>
</section>
