<%# Side panel (Figma W03): open tasks without a time, grouped by project. Locals: unscheduled (groups of tasks). %>
<% const count = unscheduled.reduce((sum, group) => sum + group.tasks.length, 0); %>
<aside class="rounded-box bg-base-100 p-4" aria-labelledby="unscheduled-heading">
  <h2 id="unscheduled-heading" class="font-semibold">Unscheduled <span class="text-muted"><%= count %></span></h2>
  <% if (count) { %>
    <p class="mt-1 text-xs text-muted">Drag a task onto the calendar to give it a time.</p>
    <div class="mt-3 max-h-[min(560px,60vh)] space-y-4 overflow-y-auto">
      <% unscheduled.forEach((group) => { %>
        <section aria-label="<%= group.name %>">
          <h3 class="mb-1.5 flex items-center gap-2 text-xs font-semibold text-muted">
            <span class="size-2 rounded-full <%= group.colour ? '' : 'bg-base-300' %>" <% if (group.colour) { %>style="background-color: <%= group.colour %>"<% } %> aria-hidden="true"></span><%= group.name %>
          </h3>
          <ul class="space-y-1.5">
            <% group.tasks.forEach((task) => { %>
              <li class="relative rounded-field bg-fill px-3 py-2 text-sm" data-unscheduled-id="<%= task._id %>">
                <a href="/tasks/<%= task._id %>" class="block truncate font-medium after:absolute after:inset-0 hover:underline"><%= task.title %></a>
                <span class="block text-xs <%= dates.isOverdue(task) ? 'font-semibold text-error' : 'text-muted' %>">
                  <%= task.dueDate ? `${dates.isOverdue(task) ? 'Overdue · ' : ''}Due ${dates.formatDay(task.dueDate, currentUser.timeZone)}` : 'No date' %>
                </span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% }) %>
    </div>
  <% } else { %>
    <p class="mt-2 text-sm text-muted">Every open task has a time.</p>
  <% } %>
</aside>
