<%- include('../partials/shell-top') %>
<div class="flex flex-wrap items-end justify-between gap-4">
  <div><h1 class="text-3xl font-bold tracking-tight">Projects</h1><p class="mt-2 text-sm text-muted">Create your own items here, each with its own tasks, name, colour and icon. Use … or right-click an item for options. Tasks without an item stay in Inbox.</p><a href="/projects/new" class="mt-2 inline-flex min-h-11 items-center text-sm font-semibold text-primary">Create a custom item</a></div>
  <form method="post" action="/projects" class="flex w-full max-w-sm items-end gap-2" novalidate>
    <%- include('../partials/csrf') %>
    <div class="min-w-0 grow">
      <label for="project-name" class="mb-1.5 block text-xs font-semibold">Quick-add item name (required)</label>
      <input id="project-name" name="name" type="text" maxlength="<%= maxNameLength %>" placeholder="New item name"
        value="<%= values.name %>" class="input h-11 w-full <%= errors.name ? 'input-error' : '' %>"
        <% if (errors.name) { %>aria-invalid="true" aria-describedby="project-name-error" autofocus<% } %>>
      <% if (errors.name) { %><p id="project-name-error" class="mt-1.5 text-sm text-error"><%= errors.name %></p><% } %>
    </div>
    <button type="submit" class="btn btn-primary h-11 rounded-full px-4">
      <%- include('../partials/icon', { icon: 'plus', cls: 'size-4' }) %> Add item
    </button>
  </form>
</div>

<ul class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  <% cards.forEach((card) => { %>
    <li class="relative min-w-0 rounded-box bg-base-100 p-5 hover:bg-base-100/70" <%= card.id ? 'data-project-item' : '' %>>
      <div class="flex items-center gap-2">
      <a href="<%= card.href %>" class="flex min-w-0 grow items-center gap-2.5 font-semibold after:absolute after:inset-0 hover:underline">
        <% if (card.colour) { %>
          <%- include('_symbol', { projectIcon: card.icon, projectColour: card.colour }) %>
        <% } else { %>
          <%- include('../partials/icon', { icon: 'inbox', cls: 'size-4 shrink-0' }) %>
        <% } %>
        <span class="truncate"><%= card.name %></span>
      </a>
      <% if (card.id) { %><%- include('_menu', { item: card }) %><% } %>
      </div>
      <p class="mt-2 text-sm text-muted"><%= card.total ? `${card.done} of ${card.total} tasks done` : 'No tasks yet' %></p>
      <progress class="progress mt-3 h-1.5 w-full" value="<%= card.done %>" max="<%= card.total || 1 %>"
        style="color: <%= card.colour || 'var(--color-base-content)' %>" aria-label="<%= card.name %> progress"></progress>
    </li>
  <% }) %>
</ul>
<%- include('../partials/shell-bottom') %>
