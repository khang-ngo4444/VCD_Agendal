<% if (locals.projectIcon) { %>
  <span class="shrink-0 text-base leading-none" aria-hidden="true"><%= projectIcon %></span>
<% } else { %>
  <span class="size-2.5 shrink-0 rounded-full <%= locals.projectColour ? '' : 'bg-base-300' %>" <% if (locals.projectColour) { %>style="background-color: <%= projectColour %>"<% } %> aria-hidden="true"></span>
<% } %>
