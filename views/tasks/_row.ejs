<%#
  One task in a list, with its done / reopen button. Locals: task (lean), timeZone.
  Dates read in the user's time zone (services/dates.js).
%>
<%
  const meta = [];
  if (task.completedAt) meta.push(`Done ${dates.formatDay(task.completedAt, timeZone)}`);
  else {
    if (task.schedule?.start) meta.push(`${dates.formatDay(task.schedule.start, timeZone)}, ${dates.formatTime(task.schedule.start, timeZone)}–${dates.formatTime(task.schedule.end, timeZone)}`);
    if (task.dueDate) meta.push(`Due ${dates.formatDay(task.dueDate, timeZone)}`);
    if (!meta.length) meta.push('No date');
  }
%>
<li class="flex items-start gap-3 px-4 py-3">
  <form method="post" action="/tasks/<%= task._id %>/complete" class="-my-2.5 -ml-3 shrink-0">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="done" value="<%= task.completedAt ? '0' : '1' %>">
    <input type="hidden" name="returnTo" value="<%= currentPath %>">
    <button type="submit" class="group grid size-11 place-items-center rounded-full"
      aria-label="<%= task.completedAt ? `Reopen “${task.title}”` : `Mark “${task.title}” as done` %>">
      <span class="grid size-5 place-items-center rounded-full border-2 <%= task.completedAt ? 'border-success bg-success text-success-content' : 'border-base-300 group-hover:border-primary' %>">
        <% if (task.completedAt) { %><%- include('../partials/icon', { icon: 'check', cls: 'size-3' }) %><% } %>
      </span>
    </button>
  </form>
  <div class="min-w-0 grow">
    <a href="/tasks/<%= task._id %>" class="block truncate font-medium hover:underline <%= task.completedAt ? 'text-muted line-through' : '' %>"><%= task.title %></a>
    <p class="mt-0.5 text-xs text-muted"><%= meta.join(' · ') %></p>
  </div>
  <% if (task.priority === 'high' && !task.completedAt) { %>
    <span class="mt-0.5 text-warning" title="High priority">
      <%- include('../partials/icon', { icon: 'flag', cls: 'size-4' }) %><span class="sr-only">High priority</span>
    </span>
  <% } %>
</li>
