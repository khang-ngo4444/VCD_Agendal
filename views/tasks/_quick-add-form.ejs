<%#
  Title-only task form used by the New task dialog and /tasks/new. Locals: projects (sidebarProjects), returnTo,
  idPrefix (keeps ids unique when both copies are on one page), autofocus?. The task lands in the Inbox unless a project is picked, and always starts in Backlog.
%>
<form method="post" action="/tasks" novalidate>
  <%- include('../partials/csrf') %>
  <input type="hidden" name="returnTo" value="<%= returnTo %>">
  <label for="<%= idPrefix %>-title" class="sr-only">Task title</label>
  <input id="<%= idPrefix %>-title" name="title" type="text" maxlength="200" placeholder="What needs doing?"
    class="input h-12 w-full text-base" required <%= locals.autofocus ? 'autofocus' : '' %>>
  <label for="<%= idPrefix %>-project" class="mt-4 mb-1.5 block text-xs font-semibold">Project</label>
  <select id="<%= idPrefix %>-project" name="project" class="select h-10 w-full">
    <% projects.forEach((project) => { %>
      <option value="<%= project.id || '' %>"><%= project.name %></option>
    <% }) %>
  </select>
  <p class="mt-3 text-xs text-muted">Only the title is required · Enter to save · Esc to close</p>
  <div class="mt-4 flex justify-end">
    <button type="submit" class="btn btn-primary h-10 rounded-full px-5">
      <%- include('../partials/icon', { icon: 'plus', cls: 'size-4' }) %> Add task
    </button>
  </div>
</form>
