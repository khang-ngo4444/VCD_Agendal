<%- include('../partials/shell-top') %>
<%# New and edit event as a page (the Calendar also opens the new-event form in a dialog). Locals: event (null when new), values, errors, returnTo. %>
<a href="<%= returnTo %>" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline">‹ Back</a>
<h1 class="mt-2 text-3xl font-bold tracking-tight"><%= event ? 'Edit event' : 'New event' %></h1>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_260px]">
  <div class="rounded-box bg-base-100 p-5">
    <%- include('_form', { action: event ? `/events/${event._id}` : '/events', submitLabel: event ? 'Save changes' : 'Add event', idPrefix: 'event' }) %>
  </div>
  <% if (event) { %>
    <aside>
      <form method="post" action="/events/<%= event._id %>/delete" data-confirm="Delete “<%= event.title %>”?"
        data-confirm-detail="<%= event.repeat?.frequency ? 'Every occurrence of this repeating event goes.' : 'This can’t be undone.' %>" data-confirm-button="Delete event">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
        <button type="submit" class="btn btn-ghost h-11 w-full rounded-full text-error"><%- include('../partials/icon', { icon: 'trash', cls: 'size-4' }) %> Delete event</button>
      </form>
    </aside>
  <% } %>
</div>
<%- include('../partials/shell-bottom') %>
