<%#
  The plan form (Figma W13e / M47c): how long and which rhythm. Used by the plan dialog on the Focus page and by the
  plan page (no JavaScript). Locals: action (the task's /focus/:id/plan; the dialog's is set when it opens),
  rhythms, totals, choice { rhythm, minutes }, cancel ('dialog' or a link).
  The custom length shows when Custom is picked (CSS only). public/js/focus.js draws the schedule preview.
%>
<% const custom = !totals.includes(choice.minutes); %>
<form method="post" action="<%= action %>" class="space-y-5" data-plan-form>
  <%- include('../partials/csrf') %>
  <fieldset class="group/length">
    <legend class="text-sm font-semibold">How long?</legend>
    <div class="mt-2 grid grid-cols-3 gap-2 sm:flex sm:flex-wrap">
      <% totals.forEach((minutes) => { %>
        <label class="cursor-pointer">
          <input type="radio" name="minutes" value="<%= minutes %>" class="peer sr-only" <%= !custom && minutes === choice.minutes ? 'checked' : '' %>>
          <span class="flex h-10 items-center justify-center rounded-full border border-base-300 bg-base-100 px-4 text-sm font-semibold peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"><%= formatMinutes(minutes) %></span>
        </label>
      <% }) %>
      <label class="cursor-pointer">
        <input type="radio" name="minutes" value="custom" class="peer sr-only" <%= custom ? 'checked' : '' %>>
        <span class="flex h-10 items-center justify-center rounded-full border border-base-300 bg-base-100 px-4 text-sm font-semibold peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">Custom…</span>
      </label>
    </div>
    <label class="mt-3 hidden items-center gap-2 text-sm group-has-[[value=custom]:checked]/length:flex">
      <input type="number" name="custom" min="10" max="240" step="5" value="<%= custom ? choice.minutes : 45 %>" class="input h-10 w-24" aria-label="Custom length in minutes">
      minutes <span class="text-muted">(10 to 240)</span>
    </label>
  </fieldset>

  <fieldset>
    <legend class="text-sm font-semibold">Rhythm</legend>
    <div class="mt-2 grid grid-cols-2 gap-2">
      <% rhythms.forEach((rhythm) => { %>
        <label class="cursor-pointer">
          <input type="radio" name="rhythm" value="<%= rhythm.key %>" class="peer sr-only" <%= rhythm.key === choice.rhythm ? 'checked' : '' %>>
          <span class="flex h-full flex-col gap-0.5 rounded-box border border-base-300 bg-base-100 p-3 peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:ring-1 peer-checked:ring-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">
            <span class="font-semibold"><%= rhythm.name %></span>
            <%# Phones get the short form (M47c) %>
            <span class="text-xs text-muted sm:hidden"><%= rhythm.focus %> · <%= rhythm.rest %> · long <%= rhythm.longRest %> after <%= rhythm.longEvery %></span>
            <span class="text-xs text-muted max-sm:hidden"><%= rhythm.focus %> min focus · <%= rhythm.rest %> min breaks</span>
            <span class="text-xs text-muted max-sm:hidden">Long break <%= rhythm.longRest %> min after <%= rhythm.longEvery %> blocks</span>
          </span>
        </label>
      <% }) %>
    </div>
  </fieldset>

  <div data-plan-preview hidden>
    <p class="text-sm font-semibold">Your session</p>
    <div class="mt-2 flex h-2.5 gap-1" aria-hidden="true" data-plan-bar></div>
    <p class="mt-1.5 text-xs text-muted" data-plan-steps></p>
    <div class="mt-3 rounded-box bg-base-200 px-4 py-3">
      <p class="font-semibold" data-plan-summary role="status"></p>
      <p class="text-sm text-muted" data-plan-ends></p>
    </div>
  </div>

  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
    <% if (cancel === 'dialog') { %>
      <button type="button" class="btn h-11 rounded-full px-5" data-plan-cancel>Cancel</button>
    <% } else { %>
      <a href="<%= cancel %>" class="btn h-11 rounded-full px-5">Cancel</a>
    <% } %>
    <button type="submit" class="btn btn-primary h-11 gap-2 rounded-full px-6">
      <%- include('../partials/icon', { icon: 'play', cls: 'size-3.5 fill-current' }) %> Start focus
    </button>
  </div>
</form>
