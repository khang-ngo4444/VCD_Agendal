<%- include('../partials/shell-top') %>
<%#
  Focus (Figma W13a): pick a task and the length. Locals: todayTasks, otherTasks (lean tasks), maxOther,
  focused { sessions, minutes } (today's finished blocks), lengths, length (the user's).
  The box above "Other open tasks" filters them as you type (public/js/focus.js); without JavaScript it is hidden.
%>
<% const timeZone = currentUser.timeZone; %>
<header class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Focus</h1>
    <p class="mt-1 text-sm text-muted">Pick one task. The timer runs a focus block, then a short break.</p>
  </div>
  <%# The length is saved to the account. One small form per option: data-fetch posts the form's own fields only. %>
  <div class="flex w-full rounded-full bg-fill p-1 sm:w-auto" role="group" aria-label="Focus length">
    <% lengths.forEach((item) => { const on = item.focus === length.focus; %>
      <form method="post" action="/focus/length" class="flex grow" data-fetch="focus-length-<%= item.focus %>">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="minutes" value="<%= item.focus %>">
        <button type="submit" aria-pressed="<%= on %>"
          class="inline-flex min-h-9 grow items-center justify-center rounded-full px-4 text-sm font-medium pointer-coarse:min-h-11 <%= on ? 'bg-base-100 shadow-sm' : 'text-muted hover:text-base-content' %>">
          <%= item.focus %> min · <%= item.rest %> break
        </button>
      </form>
    <% }) %>
  </div>
</header>

<div class="mt-6 grid grid-cols-[minmax(0,1fr)] items-start gap-5 lg:grid-cols-[minmax(0,1fr)_340px]">
  <div class="space-y-5">
    <section class="rounded-box bg-base-100 pb-2" aria-labelledby="focus-today-heading">
      <div class="flex flex-wrap items-baseline justify-between gap-x-2 px-4 pt-4 pb-1">
        <h2 id="focus-today-heading" class="text-lg font-semibold">Today</h2>
        <p class="text-xs text-muted">Same tasks as the Daily List</p>
      </div>
      <% if (todayTasks.length) { %>
        <ul class="divide-y divide-base-300/70">
          <% todayTasks.forEach((task) => { %><%- include('_task', { task, timeZone }) %><% }) %>
        </ul>
      <% } else { %>
        <%- include('../partials/empty-state', { icon: 'sun', heading: 'Nothing left for today', text: 'Pick any open task below, or plan one on the Daily List.' }) %>
      <% } %>
    </section>

    <section class="rounded-box bg-base-100 pb-2" aria-labelledby="focus-other-heading">
      <h2 id="focus-other-heading" class="px-4 pt-4 text-lg font-semibold">Other open tasks</h2>
      <% if (otherTasks.length) { %>
        <div class="px-4 pt-3 pb-1" data-focus-filter hidden>
          <label class="input h-11 w-full">
            <%- include('../partials/icon', { icon: 'search', cls: 'size-4 shrink-0 text-muted' }) %>
            <input type="search" placeholder="Find a task…" aria-label="Find a task" aria-controls="focus-other-list" class="grow">
          </label>
        </div>
        <ul id="focus-other-list" class="divide-y divide-base-300/70">
          <% otherTasks.forEach((task) => { %><%- include('_task', { task, timeZone }) %><% }) %>
        </ul>
        <p class="px-4 py-6 text-center text-sm text-muted" data-focus-no-match role="status" hidden>No open task matches.</p>
        <% if (otherTasks.length === maxOther) { %><p class="px-4 pt-2 text-xs text-muted">The <%= maxOther %> most recently changed tasks. Search finds the rest.</p><% } %>
      <% } else { %>
        <p class="px-4 py-6 text-sm text-muted">No other open tasks.</p>
      <% } %>
    </section>
  </div>

  <%# On phones today's total comes first (M47a); the keyboard tips are for desktops only %>
  <aside class="-order-1 flex flex-col gap-5 lg:order-none">
    <section class="rounded-box bg-base-100 p-4 lg:p-5" aria-labelledby="focus-stats-heading">
      <h2 id="focus-stats-heading" class="text-sm font-semibold text-muted">Focused today</h2>
      <p class="mt-1 text-3xl font-bold tracking-tight tabular-nums lg:text-4xl"><%= focused.minutes %> min</p>
      <p class="mt-1 text-sm text-muted"><%= focused.sessions.length %> session<%= focused.sessions.length === 1 ? '' : 's' %></p>
      <% if (focused.sessions.length) { %>
        <ul class="mt-4 space-y-1.5 text-sm">
          <% focused.sessions.forEach((session) => { %>
            <li class="flex gap-2.5"><span class="font-medium tabular-nums"><%= dates.formatTime(session.startedAt, timeZone) %></span>
              <span class="min-w-0 truncate text-muted"><%= session.task?.title ?? 'Deleted task' %> · <%= session.minutes %> min</span></li>
          <% }) %>
        </ul>
      <% } %>
    </section>
    <section class="rounded-box border border-base-300 p-5 max-lg:hidden" aria-labelledby="focus-how-heading">
      <h2 id="focus-how-heading" class="font-semibold">How it works</h2>
      <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm text-muted">
        <li>Focus until the timer ends, then take a break</li>
        <li><kbd class="kbd kbd-sm">Space</kbd> pauses · <kbd class="kbd kbd-sm">Esc</kbd> leaves</li>
        <li>Only finished focus blocks are counted</li>
        <li>Complete the task right from the timer</li>
      </ul>
    </section>
  </aside>
</div>
<script src="/js/focus.js" defer></script>
<%- include('../partials/shell-bottom') %>
