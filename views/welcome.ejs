<%- include('partials/header') %>
<%# First-run Welcome screen (Figma W18, reduced to what the Trello card asks for). %>
<div class="min-h-screen bg-base-200 px-4 py-8">
  <div class="mx-auto max-w-[1100px]">
    <span class="grid size-10 place-items-center rounded-xl bg-neutral text-neutral-content">
      <%- include('partials/icon', { icon: 'check', cls: 'size-5' }) %>
    </span>
  </div>

  <main id="main" class="mx-auto mt-10 max-w-xl text-center">
    <p class="text-xs font-semibold tracking-wide text-primary uppercase">Welcome<%= currentUser.name ? `, ${currentUser.name.split(' ')[0]}` : '' %></p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">Let’s set up your Agendal</h1>
    <p class="mt-3 text-muted">Capture tasks, plan them on the board or calendar, and work through them in your Daily List.</p>

    <form method="post" action="/welcome" class="mt-8 rounded-box bg-base-100 p-6 text-left" novalidate>
      <%- include('partials/csrf') %>

      <label for="timeZone" class="mb-1.5 block text-xs font-semibold">Your time zone</label>
      <select id="timeZone" name="timeZone" class="select h-11 w-full" aria-describedby="timeZone-hint" data-detect-time-zone>
        <% timeZones.forEach((zone) => { %>
          <option value="<%= zone.value %>" <%= zone.value === currentUser.timeZone ? 'selected' : '' %>><%= zone.label %></option>
        <% }) %>
      </select>
      <p id="timeZone-hint" class="mt-1.5 text-sm text-muted">Decides what “today” and “overdue” mean for you.</p>

      <fieldset class="mt-6">
        <legend class="mb-1.5 text-xs font-semibold">Your week starts on</legend>
        <div class="join">
          <input type="radio" name="weekStartsOn" value="1" class="join-item btn h-11 w-28" aria-label="Monday" <%= currentUser.preferences.weekStartsOn === 1 ? 'checked' : '' %>>
          <input type="radio" name="weekStartsOn" value="0" class="join-item btn h-11 w-28" aria-label="Sunday" <%= currentUser.preferences.weekStartsOn === 0 ? 'checked' : '' %>>
        </div>
      </fieldset>

      <label for="projectName" class="mt-6 mb-1.5 block text-xs font-semibold">Your first project <span class="font-normal text-muted">(optional)</span></label>
      <input id="projectName" name="projectName" type="text" maxlength="60" placeholder="e.g. Web Design course" class="input h-11 w-full">

      <div class="mt-8 flex flex-col-reverse items-center gap-3 sm:flex-row sm:justify-end sm:gap-6">
        <button type="submit" name="skip" value="1" class="inline-flex min-h-11 items-center font-semibold text-primary hover:underline">Skip for now</button>
        <button type="submit" class="btn btn-primary h-11 w-full rounded-full px-7 sm:w-auto">Continue</button>
      </div>
    </form>
  </main>
</div>
<%- include('partials/footer') %>
