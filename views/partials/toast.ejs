<%#
  One toast on the inverse surface (Figma DS 10). Locals: type ('success' | 'info' | 'error'), message, actionLabel?,
  undoUrl? (server-rendered Undo: a small form, so it works without JavaScript; it returns to the current page)
  The server renders it for flash messages; public/js/app.js clones it from the templates in footer.ejs.
%>
<%
  const variants = {
    success: { icon: 'check', cls: 'bg-success text-success-content' },
    info: { icon: 'bell', cls: 'bg-primary text-primary-content' },
    error: { icon: 'alert', cls: 'bg-error text-error-content' },
  };
  const variant = variants[type] ?? variants.info;
%>
<div class="pointer-events-auto flex w-max max-w-[calc(100vw-2rem)] items-center gap-3 rounded-box bg-neutral py-2.5 pl-3 pr-4 text-sm text-neutral-content shadow-lg"
  data-toast <% if (type === 'error') { %>role="alert"<% } %>>
  <span class="grid size-5 shrink-0 place-items-center rounded-full <%= variant.cls %>">
    <%- include('icon', { icon: variant.icon, cls: 'size-3' }) %>
  </span>
  <span class="grow" data-toast-message><%= message %></span>
  <% if (locals.undoUrl) { %>
    <form method="post" action="<%= undoUrl %>">
      <%- include('csrf') %>
      <% if (locals.currentUrl) { %><input type="hidden" name="returnTo" value="<%= currentUrl %>"><% } %>
      <button type="submit" class="min-h-8 font-semibold text-inverse-primary hover:underline">Undo</button>
    </form>
  <% } else { %>
    <button type="button" class="min-h-8 font-semibold text-inverse-primary hover:underline" data-toast-action
      <% if (!locals.actionLabel) { %>hidden<% } %>><%= locals.actionLabel || '' %></button>
  <% } %>
  <button type="button" class="grid size-11 shrink-0 place-items-center rounded-field hover:bg-neutral-content/10" aria-label="Dismiss notification" data-toast-dismiss hidden>
    <%- include('icon', { icon: 'x', cls: 'size-4' }) %>
  </button>
</div>
