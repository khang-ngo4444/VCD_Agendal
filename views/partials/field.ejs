<%#
  Labelled input with a leading icon and its error or hint underneath.
  Locals: name, label, type, icon, autocomplete, value?, error?, errorLink? { href, text }, hint?
%>
<%
  const messageId = `${name}-message`;
  const hasMessage = locals.error || locals.hint;
%>
<div class="mb-4">
  <label for="<%= name %>" class="mb-1.5 block text-xs font-semibold"><%= label %></label>
  <div class="input h-11 w-full bg-fill <%= locals.error ? 'input-error' : 'border-transparent' %>">
    <%- include('icon', { icon, cls: 'size-4 shrink-0 text-muted' }) %>
    <input id="<%= name %>" name="<%= name %>" type="<%= type %>" value="<%= locals.value || '' %>"
      autocomplete="<%= autocomplete %>" class="grow"
      <% if (hasMessage) { %>aria-describedby="<%= messageId %>"<% } %>
      <% if (locals.error) { %>aria-invalid="true"<% } %>>
  </div>
  <% if (locals.error) { %>
    <p id="<%= messageId %>" class="mt-1.5 flex items-center gap-1.5 text-sm text-error">
      <%- include('icon', { icon: 'alert', cls: 'size-4 shrink-0' }) %>
      <span><%= error %><% if (locals.errorLink) { %> <a href="<%= errorLink.href %>" class="underline"><%= errorLink.text %></a><% } %></span>
    </p>
  <% } else if (locals.hint) { %>
    <p id="<%= messageId %>" class="mt-1.5 text-sm text-muted"><%= hint %></p>
  <% } %>
</div>
