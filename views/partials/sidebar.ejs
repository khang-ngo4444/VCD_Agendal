<%
  // Figma names: "Today" is the Daily List, "Insights" is Statistics.
  const navItems = [
    { href: '/today', label: 'Today', icon: 'sun' },
    { href: '/upcoming', label: 'Upcoming', icon: 'inbox' },
    { href: '/board', label: 'Board', icon: 'columns' },
    { href: '/calendar', label: 'Calendar', icon: 'calendar' },
    { href: '/habits', label: 'Habits', icon: 'repeat' },
    { href: '/search', label: 'Search', icon: 'search' },
    { href: '/focus', label: 'Focus', icon: 'timer' },
    { href: '/insights', label: 'Insights', icon: 'chart' },
  ];
  const displayName = currentUser.name || currentUser.email;
  const itemClass = (href) => (currentPath === href ? 'bg-primary/[0.07] font-semibold text-primary' : 'hover:bg-base-200');
%>
<nav aria-label="Main" class="flex min-h-full w-[260px] flex-col border-r border-base-300 bg-base-100 p-4">
  <a href="/today" class="mb-5 flex items-center gap-2.5 px-1 text-lg font-bold">
    <span class="grid size-8 place-items-center rounded-lg bg-neutral text-neutral-content">
      <%- include('icon', { icon: 'check', cls: 'size-4' }) %>
    </span>
    Agendal
  </a>

  <ul class="space-y-0.5">
    <% navItems.forEach((item) => { %>
      <li>
        <a href="<%= item.href %>" class="flex h-9 pointer-coarse:h-11 items-center gap-3 rounded-field px-2.5 text-sm <%= itemClass(item.href) %>"
          <% if (currentPath === item.href) { %>aria-current="page"<% } %>>
          <%- include('icon', { icon: item.icon, cls: 'size-4 shrink-0' }) %>
          <%= item.label %>
        </a>
      </li>
    <% }) %>
  </ul>

  <h2 class="mt-6 mb-1 px-2.5 text-xs font-semibold text-muted">Projects</h2>
  <ul class="space-y-0.5">
    <% sidebarProjects.forEach((project) => { %>
      <li>
        <a href="<%= project.href %>" class="flex h-9 pointer-coarse:h-11 items-center gap-3 rounded-field px-2.5 text-sm <%= itemClass(project.href) %>"
          <% if (currentPath === project.href) { %>aria-current="page"<% } %>>
          <span class="size-2.5 shrink-0 rounded-full <%= project.colour ? '' : 'bg-base-300' %>"
            <% if (project.colour) { %>style="background-color: <%= project.colour %>"<% } %> aria-hidden="true"></span>
          <span class="grow truncate"><%= project.name %></span>
          <% if (project.total) { %>
            <span class="text-xs text-muted tabular-nums"><%= project.done %>/<%= project.total %><span class="sr-only"> tasks done</span></span>
          <% } %>
        </a>
      </li>
    <% }) %>
    <li>
      <a href="/projects" class="flex h-9 pointer-coarse:h-11 items-center gap-3 rounded-field px-2.5 text-sm text-primary hover:bg-base-200">
        <%- include('icon', { icon: 'plus', cls: 'size-4 shrink-0' }) %>
        New project
      </a>
    </li>
  </ul>

  <details class="dropdown dropdown-top mt-auto pt-4" data-dismissable>
    <summary class="flex cursor-pointer list-none items-center gap-3 rounded-field p-2 hover:bg-base-200" aria-label="Account menu for <%= displayName %>">
      <%- include('avatar', { user: currentUser, cls: 'size-9 text-sm' }) %>
      <span class="min-w-0 grow">
        <span class="block truncate text-sm font-semibold"><%= displayName %></span>
        <span class="block text-xs text-muted">Settings</span>
      </span>
      <%- include('icon', { icon: 'settings', cls: 'size-4 shrink-0 text-muted' }) %>
    </summary>
    <ul class="menu dropdown-content z-50 mb-2 w-full rounded-box border border-base-300 bg-base-100 p-2 shadow-lg">
      <li><a href="/settings/profile">Profile</a></li>
      <li><a href="/settings">Settings</a></li>
      <li><button type="submit" form="logout-form" class="text-error">Log out</button></li>
    </ul>
  </details>
  <form id="logout-form" method="post" action="/logout" hidden><%- include('csrf') %></form>
</nav>
