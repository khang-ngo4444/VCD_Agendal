<%# Logged-in layout (Figma W01). Pair with shell-bottom; the page content goes between them. %>
<%- include('header') %>
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-field focus:bg-base-100 focus:px-4 focus:py-2">Skip to content</a>
<div class="drawer lg:drawer-open">
  <input id="app-drawer" type="checkbox" class="drawer-toggle" tabindex="-1" aria-hidden="true">
  <div class="drawer-content flex min-h-screen flex-col bg-base-200">
    <header class="sticky top-0 z-30 bg-base-200/90 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-[1100px] items-center gap-3 px-4 lg:px-8">
        <label for="app-drawer" class="btn btn-ghost btn-square -ml-2 size-11 lg:hidden" role="button" tabindex="0"
          aria-label="Open navigation" aria-controls="app-navigation" aria-expanded="false" data-key-click data-drawer-open>
          <%- include('icon', { icon: 'menu', cls: 'size-5' }) %>
        </label>
        <form id="search-form" action="/search" method="get" role="search" class="max-w-sm grow">
          <label class="input h-11 w-full bg-fill">
            <%- include('icon', { icon: 'search', cls: 'size-4 shrink-0 text-muted' }) %>
            <input type="search" name="q" placeholder="Search tasks…" aria-label="Search tasks" class="h-full grow"
              value="<%= locals.searchQuery ?? '' %>" <%= currentPath === '/search' ? 'autofocus' : '' %>>
          </label>
        </form>
        <a href="/tasks/new" class="btn btn-primary ml-auto h-11 min-w-11 rounded-full px-4" aria-label="New task" data-open-modal="new-task-dialog">
          <%- include('icon', { icon: 'plus', cls: 'size-4' }) %>
          <span class="hidden sm:inline">New task</span>
        </a>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-[1100px] flex-1 px-4 py-6 lg:px-8 lg:py-8">
