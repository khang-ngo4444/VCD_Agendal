<%- include('../partials/header') %>
<div class="grid min-h-screen lg:grid-cols-[4fr_5fr]">
  <%- include('_aside') %>
  <main class="flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <a href="/login" class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-primary hover:underline">‹ Back to log in</a>
      <h1 class="mt-2 text-3xl font-bold tracking-tight">Reset your password</h1>
      <p class="mt-2 text-sm text-muted">Enter your email and we’ll send a reset link. It works for 30 minutes.</p>

      <form method="post" action="/forgot-password" class="mt-6" novalidate>
        <%- include('../partials/csrf') %>
        <%- include('../partials/field', {
          name: 'email', label: 'Email', type: 'email', icon: 'mail', autocomplete: 'email',
          value: values.email, error: errors.email,
        }) %>
        <button type="submit" class="btn btn-primary h-11 w-full rounded-full"><%= sent ? 'Send another link' : 'Send reset link' %></button>
      </form>

      <% if (sent) { %>
        <div role="status" class="mt-4 flex items-start gap-3 rounded-field border border-primary px-4 py-3">
          <%- include('../partials/icon', { icon: 'mail', cls: 'mt-0.5 size-4 shrink-0 text-primary' }) %>
          <div class="text-sm">
            <p class="font-semibold">Check your inbox</p>
            <p class="text-muted">If <%= values.email %> has an Agendal account, a reset link is on its way.</p>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
