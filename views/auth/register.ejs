<%- include('../partials/header') %>
<div class="grid min-h-screen lg:grid-cols-[4fr_5fr]">
  <%- include('_aside') %>
  <main class="flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <h1 class="text-3xl font-bold tracking-tight">Create your account</h1>
      <p class="mt-2 text-sm text-muted">Free for students. Takes about 30 seconds.</p>

      <%- include('_oauth-buttons') %>

      <%# Cursor goes to the first field with an error, or to the name on a fresh form %>
      <% const focusField = ['name', 'email', 'password'].find((field) => errors[field]) || 'name'; %>
      <form method="post" action="/register" class="mt-6" novalidate>
        <%- include('../partials/csrf') %>
        <%- include('../partials/field', {
          name: 'name', label: 'Full name', type: 'text', icon: 'user', autocomplete: 'name',
          autofocus: focusField === 'name', maxlength: 80,
          value: values.name, error: errors.name,
        }) %>
        <%- include('../partials/field', {
          name: 'email', label: 'Email', type: 'email', icon: 'mail', autocomplete: 'email',
          autofocus: focusField === 'email', maxlength: 254,
          value: values.email, error: errors.email,
          errorLink: errors.emailTaken ? { href: '/login', text: 'Log in instead?' } : null,
        }) %>
        <%- include('../partials/field', {
          name: 'password', label: 'Password', type: 'password', icon: 'lock', autocomplete: 'new-password',
          autofocus: focusField === 'password', maxlength: 72,
          error: errors.password, hint: passwordHint,
        }) %>
        <button type="submit" class="btn btn-primary mt-2 h-11 w-full rounded-full">Create account</button>
      </form>

      <p class="mt-4 text-sm text-muted">
        Already have an account? <a href="/login" class="font-semibold text-primary hover:underline">Log in</a>
      </p>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
