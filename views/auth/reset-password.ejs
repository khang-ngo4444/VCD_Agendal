<%- include('../partials/header') %>
<div class="grid min-h-screen lg:grid-cols-[4fr_5fr]">
  <%- include('_aside') %>
  <main class="flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <% if (!tokenValid) { %>
        <h1 class="text-3xl font-bold tracking-tight">This link has expired</h1>
        <p class="mt-2 text-sm text-muted">Reset links work once, for 30 minutes. Ask for a new one and use the latest email.</p>
        <a href="/forgot-password" class="btn btn-primary mt-6 h-11 w-full rounded-full">Send a new link</a>
      <% } else { %>
        <h1 class="text-3xl font-bold tracking-tight">Choose a new password</h1>
        <p class="mt-2 text-sm text-muted">You’ll be logged in, and signed out everywhere else.</p>
        <form method="post" class="mt-6" novalidate>
          <%- include('../partials/csrf') %>
          <%- include('../partials/field', {
            name: 'newPassword', label: 'New password', type: 'password', icon: 'lock', autocomplete: 'new-password',
            autofocus: !errors.confirmPassword, maxlength: 72,
            error: errors.newPassword, hint: passwordHint,
          }) %>
          <%- include('../partials/field', {
            name: 'confirmPassword', label: 'Confirm new password', type: 'password', icon: 'lock',
            autocomplete: 'new-password', error: errors.confirmPassword, autofocus: Boolean(errors.confirmPassword), maxlength: 72,
          }) %>
          <button type="submit" class="btn btn-primary h-11 w-full rounded-full">Save password and log in</button>
        </form>
      <% } %>
    </div>
  </main>
</div>
<%- include('../partials/footer') %>
