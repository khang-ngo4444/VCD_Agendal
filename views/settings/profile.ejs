<%- include('../partials/shell-top') %>
<h1 class="text-3xl font-bold tracking-tight">Settings</h1>
<div class="mt-6 grid gap-6 md:grid-cols-[180px_1fr]">
  <%- include('_nav') %>
  <section aria-labelledby="profile-heading">
    <h2 id="profile-heading" class="text-xl font-bold">Profile</h2>
    <p class="mt-1 text-sm text-muted">Signed in as <%= currentUser.email %></p>

    <form method="post" action="/settings/profile" class="mt-6 rounded-box bg-base-100 p-5" novalidate>
      <%- include('../partials/csrf') %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="name" class="mb-1.5 block text-xs font-semibold">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" maxlength="80" value="<%= values.name %>"
            class="input h-11 w-full <%= errors.name ? 'input-error' : '' %>"
            <% if (errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
          <% if (errors.name) { %><p id="name-error" class="mt-1.5 text-sm text-error"><%= errors.name %></p><% } %>
        </div>
        <div>
          <label for="timeZone" class="mb-1.5 block text-xs font-semibold">Time zone</label>
          <select id="timeZone" name="timeZone" class="select h-11 w-full <%= errors.timeZone ? 'select-error' : '' %>"
            <% if (errors.timeZone) { %>aria-invalid="true" aria-describedby="timeZone-error"<% } %>>
            <% timeZones.forEach((zone) => { %>
              <option value="<%= zone.value %>" <%= zone.value === values.timeZone ? 'selected' : '' %>><%= zone.label %></option>
            <% }) %>
          </select>
          <p id="timeZone-error" class="mt-1.5 text-sm <%= errors.timeZone ? 'text-error' : 'text-muted' %>">
            <%= errors.timeZone || 'Used for “today”, due dates and reminders.' %>
          </p>
        </div>
      </div>
      <div class="mt-6 flex justify-end">
        <button type="submit" class="btn btn-primary h-10 rounded-full px-5">Save changes</button>
      </div>
    </form>
  </section>
</div>
<%- include('../partials/shell-bottom') %>
