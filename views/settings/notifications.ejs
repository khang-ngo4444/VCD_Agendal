<%- include('../partials/shell-top') %>
<h1 class="text-3xl font-bold tracking-tight">Settings</h1>
<div class="mt-6 grid gap-6 md:grid-cols-[180px_1fr]">
  <%- include('_nav') %>
  <section aria-labelledby="notifications-heading">
    <h2 id="notifications-heading" class="text-xl font-bold">Notifications</h2>
    <p class="mt-1 text-sm text-muted">Reminders are sent at the time you choose on each task.</p>

    <form method="post" action="/settings/notifications" class="mt-6 max-w-xl space-y-6" data-autosave>
      <%- include('../partials/csrf') %>

      <fieldset class="rounded-box bg-base-100 p-5">
        <legend class="sr-only">How reminders reach you</legend>
        <h3 class="mb-2 text-xs font-semibold tracking-wide text-muted uppercase">How reminders reach you</h3>
        <%# Figma W12 "last delivered": whether reminders actually reach this account (services/deliveries.js). %>
        <p class="mb-1 flex items-start gap-2 text-sm text-muted">
          <%- include('../partials/icon', { icon: 'clock', cls: 'mt-0.5 size-4 shrink-0' }) %>
          <span><% if (lastSent) { %>Last sent: <%= lastSent %>.<% } else { %>Nothing sent yet. Set a reminder on a task to get your first one.<% } %></span>
        </p>

        <div class="border-b border-base-300">
          <% if (!vapidPublicKey) { %><p class="mt-3 rounded-field bg-base-200 p-3 text-sm text-muted">Browser delivery is not configured on this server. The switch saves your account preference; email reminders can still be used.</p><% } %>
          <label class="flex cursor-pointer items-center gap-4 py-3">
            <%- include('../partials/icon', { icon: 'bell', cls: 'size-5 shrink-0 text-muted' }) %>
            <span class="flex-1">
              <span class="block font-medium">Browser notifications</span>
              <span class="block text-sm text-muted">Windows / Mac notification center, Android lock screen, iPhone app on the Home Screen.</span>
            </span>
            <input type="checkbox" name="push" class="toggle toggle-success" <%= values.push ? 'checked' : '' %>>
          </label>
          <%# This browser's own state (public/js/push.js fills it in): the toggle above is for the whole account. %>
          <div class="-mt-1 mb-3 ml-9 rounded-field bg-base-200 px-3 py-2.5 text-sm" data-push-status hidden aria-live="polite">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-push-when="on" hidden>
              <span class="flex items-center gap-2 grow"><span class="size-2 rounded-full bg-success"></span> On in this browser.</span>
              <button type="button" class="btn btn-sm h-9 rounded-full border-0 bg-base-100" data-push-test>Send a test</button>
              <button type="button" class="btn btn-ghost btn-sm h-9 rounded-full" data-push-off>Turn off here</button>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-push-when="off" hidden>
              <span class="grow text-muted">Not on in this browser yet.</span>
              <button type="button" class="btn btn-primary btn-sm h-9 rounded-full" data-push-open>Turn on in this browser</button>
            </div>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2" data-push-when="blocked" hidden>
              <span class="flex items-center gap-2 grow"><span class="size-2 rounded-full bg-error"></span> Blocked in this browser.</span>
              <button type="button" class="btn btn-sm h-9 rounded-full border-0 bg-base-100" data-push-open>How to unblock</button>
            </div>
            <p class="text-muted" data-push-when="unsupported" hidden>
              This browser can’t show notifications from websites. On an iPhone, add Agendal to the Home Screen first.
            </p>
          </div>
        </div>

        <label class="flex cursor-pointer items-center gap-4 py-3">
          <%- include('../partials/icon', { icon: 'mail', cls: 'size-5 shrink-0 text-muted' }) %>
          <span class="flex-1">
            <span class="block font-medium">Email reminders</span>
            <span class="block text-sm text-muted">Sent to <%= currentUser.email %>.</span>
          </span>
          <input type="checkbox" name="email" class="toggle toggle-success" <%= values.email ? 'checked' : '' %>>
        </label>

        <p class="mt-2 rounded-field bg-base-200 px-3 py-2 text-sm text-muted">
          Reminders due together arrive in one email: at most 1 every <%= limits.emailGapMinutes %> minutes and <%= limits.emailsPerDay %> a day.
          Every email has a link to turn email reminders off.
        </p>
      </fieldset>

      <fieldset class="rounded-box bg-base-100 p-5">
        <legend class="sr-only">Daily summary</legend>
        <h3 class="mb-2 text-xs font-semibold tracking-wide text-muted uppercase">Daily summary</h3>
        <label class="flex cursor-pointer items-center gap-4 py-3">
          <%- include('../partials/icon', { icon: 'sun', cls: 'size-5 shrink-0 text-muted' }) %>
          <span class="flex-1">
            <span class="block font-medium">Send me my day</span>
            <span class="block text-sm text-muted">Today’s tasks, overdue tasks, habits and events in one message: a notification if this account has one on, else an email.</span>
          </span>
          <input type="checkbox" name="dailySummary" class="toggle toggle-success" <%= values.dailySummary ? 'checked' : '' %>>
        </label>
        <div class="ml-9 flex flex-wrap items-center gap-3">
          <label for="dailySummaryTime" class="text-sm font-medium">At</label>
          <input id="dailySummaryTime" name="dailySummaryTime" type="time" value="<%= values.dailySummaryTime %>" required
            class="input h-11 w-36 <%= errors.dailySummaryTime ? 'input-error' : '' %>"
            aria-describedby="dailySummaryTime-hint" <% if (errors.dailySummaryTime) { %>aria-invalid="true"<% } %>>
          <span id="dailySummaryTime-hint" class="text-sm <%= errors.dailySummaryTime ? 'text-error' : 'text-muted' %>">
            <%= errors.dailySummaryTime || `In your time zone (${currentUser.timeZone}).` %>
          </span>
        </div>
      </fieldset>

      <noscript>
        <div class="flex justify-end">
          <button type="submit" class="btn btn-primary h-10 rounded-full px-5">Save changes</button>
        </div>
      </noscript>
    </form>
  </section>
</div>
<%- include('../partials/shell-bottom') %>
