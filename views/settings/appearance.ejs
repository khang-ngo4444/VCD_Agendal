<%- include('../partials/shell-top') %>
<%
  const themes = [
    { value: 'light', label: 'Light', preview: 'bg-[#f5f5f7]', panel: 'bg-white' },
    { value: 'dark', label: 'Dark', preview: 'bg-[#1c1c1e]', panel: 'bg-[#2c2c2e]' },
    { value: 'system', label: 'Match system', preview: 'bg-[linear-gradient(90deg,#f5f5f7_50%,#1c1c1e_50%)]', panel: 'bg-white/80' },
  ];
  const accents = [
    { value: 'blue', label: 'Blue', hex: '#0066cc' },
    { value: 'purple', label: 'Purple', hex: '#8b5cf6' },
    { value: 'green', label: 'Green', hex: '#2e9e6a' },
    { value: 'orange', label: 'Orange', hex: '#e8730c' },
    { value: 'graphite', label: 'Graphite', hex: '#1d1d1f' },
  ];
%>
<h1 class="text-3xl font-bold tracking-tight">Settings</h1>
<div class="mt-6 grid gap-6 md:grid-cols-[180px_1fr]">
  <%- include('_nav') %>
  <section aria-labelledby="appearance-heading">
    <h2 id="appearance-heading" class="text-xl font-bold">Appearance</h2>
    <p class="mt-1 text-sm text-muted">Saved to your account, so it applies on every device you sign in to.</p>

    <form method="post" action="/settings/appearance" class="mt-6 space-y-8" data-autosave>
      <%- include('../partials/csrf') %>

      <fieldset>
        <legend class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Theme</legend>
        <div class="grid gap-4 sm:grid-cols-3">
          <% themes.forEach((theme) => { %>
            <label class="group relative cursor-pointer" data-theme-option="<%= theme.value %>">
              <input type="radio" name="theme" value="<%= theme.value %>" class="peer sr-only" <%= values.theme === theme.value ? 'checked' : '' %>>
              <span class="theme-card block h-24 rounded-box border-2 border-base-300 p-3 peer-checked:border-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary <%= theme.preview %>" aria-hidden="true">
                <span class="theme-pulse-ring"></span>
                <span class="theme-preview-accent block h-2 w-10 rounded-full"></span>
                <span class="mt-3 block h-3 w-3/4 rounded <%= theme.panel %>"></span>
                <span class="mt-2 block h-3 w-1/2 rounded <%= theme.panel %>"></span>
              </span>
              <span class="mt-2 flex items-center gap-2 text-sm font-medium">
                <span class="theme-dot size-4 rounded-full border-2 border-base-300 group-has-[:checked]:border-[5px] group-has-[:checked]:border-primary" aria-hidden="true"></span>
                <%= theme.label %>
              </span>
            </label>
          <% }) %>
        </div>
      </fieldset>

      <fieldset>
        <legend class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Accent colour</legend>
        <div class="flex flex-wrap gap-3">
          <% accents.forEach((accent) => { %>
            <label class="cursor-pointer">
              <input type="radio" name="accentColour" value="<%= accent.value %>" class="peer sr-only" aria-label="<%= accent.label %>" <%= values.accentColour === accent.value ? 'checked' : '' %>>
              <span class="block size-11 rounded-full border-4 border-base-200 ring-2 ring-transparent peer-checked:ring-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-primary"
                style="background-color: <%= accent.hex %>" aria-hidden="true"></span>
            </label>
          <% }) %>
        </div>
        <p class="mt-2 text-sm text-muted">Used only for things you can click: buttons, links and selections.</p>
      </fieldset>

      <div class="flex flex-wrap gap-x-10 gap-y-8">
      <fieldset>
        <legend class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">First day of the week</legend>
        <div class="join">
          <input type="radio" name="weekStartsOn" value="1" class="join-item btn h-11 w-28" aria-label="Monday" <%= values.weekStartsOn === 1 ? 'checked' : '' %>>
          <input type="radio" name="weekStartsOn" value="0" class="join-item btn h-11 w-28" aria-label="Sunday" <%= values.weekStartsOn === 0 ? 'checked' : '' %>>
        </div>
      </fieldset>
      <fieldset>
        <legend class="mb-3 text-xs font-semibold tracking-wide text-muted uppercase">Default calendar layout</legend>
        <div class="join">
          <% [['day', 'Day'], ['week', 'Week'], ['month', 'Month']].forEach(([value, label]) => { %>
            <input type="radio" name="calendarLayout" value="<%= value %>" class="join-item btn h-11 w-24" aria-label="<%= label %>" <%= values.calendarLayout === value ? 'checked' : '' %>>
          <% }) %>
        </div>
      </fieldset>
      </div>

      <noscript>
        <div class="flex justify-end gap-2">
          <button type="submit" class="btn btn-primary h-11 rounded-full px-5">Save changes</button>
        </div>
      </noscript>
    </form>
  </section>
</div>
<script src="/js/appearance.js" defer></script>
<%- include('../partials/shell-bottom') %>
