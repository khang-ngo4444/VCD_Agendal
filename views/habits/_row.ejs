<%#
  One habit with its check-in toggle for the local day `date`. Locals: summary (loadSummaries in services/habits.js), date,
  editable? (default true; false shows the state without a toggle, for days outside the check-in window).
  Habits not due that day are greyed out but can still be checked in.
%>
<%
  const { habit, due, doneOnDate, streak, week, frequencyLabel } = summary;
  const circle = `grid size-6 place-items-center rounded-full border-2 text-white ${due || doneOnDate ? '' : 'opacity-50'}`;
  const fill = `border-color: ${habit.colour};${doneOnDate ? ` background-color: ${habit.colour}` : ''}`;
%>
<li class="relative flex items-center gap-3 px-4 py-3 hover:bg-base-200/60 <%= due ? '' : 'text-muted' %>">
  <% if (locals.editable === false) { %>
    <span class="-my-2.5 -ml-3 grid size-11 shrink-0 place-items-center">
      <span class="<%= circle %>" style="<%= fill %>"><% if (doneOnDate) { %><%- include('../partials/icon', { icon: 'check', cls: 'size-3.5' }) %><% } %></span>
      <span class="sr-only"><%= doneOnDate ? 'Done' : 'Not done' %></span>
    </span>
  <% } else { %>
    <form method="post" action="/habits/<%= habit._id %>/check-ins" class="relative z-10 -my-2.5 -ml-3 shrink-0" data-fetch>
      <%- include('../partials/csrf') %>
      <input type="hidden" name="date" value="<%= date %>">
      <input type="hidden" name="done" value="<%= doneOnDate ? '0' : '1' %>">
      <input type="hidden" name="returnTo" value="<%= currentUrl %>">
      <button type="submit" class="grid size-11 place-items-center rounded-full" aria-pressed="<%= doneOnDate %>" aria-label="Done: <%= habit.name %>">
        <span class="<%= circle %>" style="<%= fill %>"><% if (doneOnDate) { %><%- include('../partials/icon', { icon: 'check', cls: 'size-3.5' }) %><% } %></span>
      </button>
    </form>
  <% } %>
  <div class="min-w-0 grow">
    <a href="/habits/<%= habit._id %>" class="block truncate font-medium after:absolute after:inset-0 hover:underline"><%= habit.name %></a>
    <p class="mt-0.5 text-xs text-muted"><%= frequencyLabel %><%= due ? '' : ' · not due today' %></p>
  </div>
  <div class="shrink-0 text-right text-xs tabular-nums">
    <p class="inline-flex items-center gap-1 font-semibold <%= streak.current ? '' : 'text-muted' %>">
      <%- include('../partials/icon', { icon: 'flame', cls: `size-3.5 ${streak.current ? 'text-warning' : ''}` }) %>
      <%= streak.current %><span class="sr-only"> <%= streak.unit %><%= streak.current === 1 ? '' : 's' %> in a row</span><span aria-hidden="true"><%= streak.unit === 'week' ? 'w' : 'd' %></span>
    </p>
    <p class="text-muted"><%= week.done %>/<%= week.target %> this week</p>
  </div>
</li>
