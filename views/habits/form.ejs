<%- include('../partials/shell-top') %>
<%#
  New and edit habit. Locals: habit (null when new), values (form strings), errors, colours, maxNameLength.
  The chosen-days and times-a-week fields only show for their frequency (CSS :has, so no script is needed).
%>
<%
  const weekStartsOn = currentUser.preferences.weekStartsOn;
  const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const weekOrder = [0, 1, 2, 3, 4, 5, 6].map((i) => (i + weekStartsOn) % 7);
  const frequencies = [
    { value: 'daily', label: 'Every day' },
    { value: 'weekdays', label: 'Weekdays', hint: 'Monday to Friday' },
    { value: 'days', label: 'Chosen days' },
    { value: 'timesPerWeek', label: 'Times a week', hint: 'Any days you like' },
  ];
  const describedBy = (field) => (errors[field] ? `aria-invalid="true" aria-describedby="${field}-error"` : '');
%>
<a href="<%= habit ? `/habits/${habit._id}` : '/habits' %>" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline">‹ <%= habit ? habit.name : 'Habits' %></a>
<h1 class="mt-2 text-3xl font-bold tracking-tight"><%= habit ? 'Edit habit' : 'New habit' %></h1>
<p class="mt-2 text-sm text-muted">Choose a name, colour and frequency. Check in when you complete the habit. Reminders are optional and use <%= currentUser.timeZone %>.</p>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_260px]">
  <form method="post" action="<%= habit ? `/habits/${habit._id}` : '/habits' %>" class="rounded-box bg-base-100 p-5" novalidate>
    <%- include('../partials/csrf') %>

    <label for="name" class="mb-1.5 block text-xs font-semibold">Name (required)</label>
    <input id="name" name="name" type="text" maxlength="<%= maxNameLength %>" value="<%= values.name %>" placeholder="e.g. Read 20 pages"
      class="input h-11 w-full text-base font-medium <%= errors.name ? 'input-error' : '' %>" <%- describedBy('name') %> <%= habit ? '' : 'autofocus' %>>
    <% if (errors.name) { %><p id="name-error" class="mt-1.5 text-sm text-error"><%= errors.name %></p><% } %>

    <fieldset class="mt-5" <%- describedBy('colour') %>>
      <legend class="mb-1.5 text-xs font-semibold">Colour</legend>
      <div class="flex flex-wrap gap-2">
        <% colours.forEach((colour) => { %>
          <label class="cursor-pointer">
            <input type="radio" name="colour" value="<%= colour.hex %>" class="peer sr-only" aria-label="<%= colour.name %>" <%= values.colour === colour.hex ? 'checked' : '' %>>
            <span class="block size-9 rounded-full border-4 border-base-100 ring-2 ring-transparent peer-checked:ring-base-content peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary"
              style="background-color: <%= colour.hex %>" aria-hidden="true"></span>
          </label>
        <% }) %>
      </div>
      <% if (errors.colour) { %><p id="colour-error" class="mt-1.5 text-sm text-error"><%= errors.colour %></p><% } %>
    </fieldset>

    <fieldset class="group mt-5" <%- describedBy('frequency') %>>
      <legend class="mb-1.5 text-xs font-semibold">How often</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% frequencies.forEach((frequency) => { %>
          <label class="flex min-h-11 cursor-pointer items-center gap-3 rounded-field border border-base-300 px-3 py-2 has-[:checked]:border-primary has-[:checked]:bg-primary/[0.07]">
            <input type="radio" name="frequencyType" value="<%= frequency.value %>" class="radio radio-sm radio-primary" <%= values.frequencyType === frequency.value ? 'checked' : '' %>>
            <span class="text-sm font-medium"><%= frequency.label %><% if (frequency.hint) { %> <span class="block text-xs font-normal text-muted"><%= frequency.hint %></span><% } %></span>
          </label>
        <% }) %>
      </div>

      <div class="mt-3 hidden flex-wrap gap-2 group-has-[[value=days]:checked]:flex">
        <% weekOrder.forEach((day) => { %>
          <label class="cursor-pointer">
            <input type="checkbox" name="days" value="<%= day %>" class="peer sr-only" <%= values.days.includes(day) ? 'checked' : '' %>>
            <span class="grid h-11 w-12 place-items-center rounded-field border border-base-300 text-sm font-medium peer-checked:border-primary peer-checked:bg-primary peer-checked:text-primary-content peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-primary">
              <span aria-hidden="true"><%= dayNames[day].slice(0, 3) %></span><span class="sr-only"><%= dayNames[day] %></span>
            </span>
          </label>
        <% }) %>
      </div>

      <div class="mt-3 hidden items-center gap-2 group-has-[[value=timesPerWeek]:checked]:flex">
        <label for="timesPerWeek" class="text-sm font-medium">Weekly target</label>
        <input id="timesPerWeek" name="timesPerWeek" type="number" min="1" max="7" value="<%= values.timesPerWeek %>" class="input h-11 w-20">
        <span class="text-sm text-muted">times a week</span>
      </div>
      <% if (errors.frequency) { %><p id="frequency-error" class="mt-1.5 text-sm text-error"><%= errors.frequency %></p><% } %>
    </fieldset>

    <label for="reminderTime" class="mt-5 mb-1.5 block text-xs font-semibold">Reminder <span class="font-normal text-muted">(optional)</span></label>
    <input id="reminderTime" name="reminderTime" type="time" value="<%= values.reminderTime %>"
      class="input h-11 w-36 <%= errors.reminderTime ? 'input-error' : '' %>" <%- describedBy('reminderTime') %>>
    <p id="reminderTime-error" class="mt-1.5 text-sm <%= errors.reminderTime ? 'text-error' : 'text-muted' %>">
      <%= errors.reminderTime || 'On days the habit is due, if it isn’t done yet.' %>
    </p>

    <div class="mt-6 flex justify-end gap-2">
      <a href="<%= habit ? `/habits/${habit._id}` : '/habits' %>" class="btn h-11 rounded-full border-0 bg-fill px-5">Cancel</a>
      <button type="submit" class="btn btn-primary h-11 rounded-full px-5"><%= habit ? 'Save changes' : 'Create habit' %></button>
    </div>
  </form>

  <% if (habit) { %>
    <aside class="space-y-3">
      <form method="post" action="/habits/<%= habit._id %>/archive">
        <%- include('../partials/csrf') %>
        <input type="hidden" name="archived" value="<%= habit.archivedAt ? '0' : '1' %>">
        <button type="submit" class="btn h-11 w-full rounded-full border border-base-300 bg-base-100 text-primary"><%= habit.archivedAt ? 'Unarchive habit' : 'Archive habit' %></button>
      </form>
      <p class="px-2 text-xs text-muted">Archiving hides the habit and keeps its history.</p>
      <form method="post" action="/habits/<%= habit._id %>/delete"
        data-confirm="Delete “<%= habit.name %>”?" data-confirm-detail="Its check-ins go too. Archive it instead to keep the history." data-confirm-button="Delete habit">
        <%- include('../partials/csrf') %>
        <button type="submit" class="btn btn-ghost h-11 w-full rounded-full text-error">
          <%- include('../partials/icon', { icon: 'trash', cls: 'size-4' }) %> Delete habit
        </button>
      </form>
    </aside>
  <% } %>
</div>
<%- include('../partials/shell-bottom') %>
