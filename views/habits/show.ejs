<%- include('../partials/shell-top') %>
<%#
  Habit detail (built from the DS tiles and calendar grid; no Figma frame yet). Locals: summary, days (the month grid,
  whole weeks), monthLabel, prevMonth, nextMonth (null for the current month), weekdayNames, last30, allTime.
%>
<%
  const { habit, streak, dailyStreak, frequencyLabel } = summary;
  const hasSchedule = habit.frequency.type !== 'daily';
  const percent = ({ rate }) => (rate === null ? '–' : `${Math.round(rate * 100)}%`);
  const unit = (count) => `${streak.unit}${count === 1 ? '' : 's'}`;
  const tiles = [
    { label: hasSchedule ? 'Current scheduled streak' : 'Current daily streak', value: streak.current, suffix: unit(streak.current) },
    { label: hasSchedule ? 'Longest scheduled streak' : 'Longest daily streak', value: streak.longest, suffix: unit(streak.longest) },
    { label: 'Last 30 days', value: percent(last30), suffix: last30.due ? `${last30.done} of ${last30.due}` : '' },
    { label: 'All time', value: percent(allTime), suffix: allTime.due ? `${allTime.done} of ${allTime.due}` : '' },
  ];
  if (hasSchedule) tiles.splice(2, 0,
    { label: 'Current daily streak', value: dailyStreak.current, suffix: dailyStreak.current === 1 ? 'day' : 'days' },
    { label: 'Longest daily streak', value: dailyStreak.longest, suffix: dailyStreak.longest === 1 ? 'day' : 'days' }
  );
  const stateText = { done: 'done', missed: 'missed', open: 'not done yet', idle: 'not due' };
%>
<a href="/habits" class="inline-flex min-h-11 items-center text-sm font-semibold text-primary hover:underline">‹ Habits</a>
<div class="mt-2 flex flex-wrap items-center gap-3">
  <span class="size-3.5 shrink-0 rounded-full" style="background-color: <%= habit.colour %>" aria-hidden="true"></span>
  <h1 class="text-3xl font-bold tracking-tight"><%= habit.name %></h1>
  <% if (habit.archivedAt) { %><span class="badge badge-soft">Archived</span><% } %>
</div>
<p class="mt-1 text-sm text-muted"><%= frequencyLabel %><% if (habit.reminderTime) { %> · Reminder at <%= habit.reminderTime %><% } %></p>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_260px]">
  <div class="min-w-0 space-y-6">
    <dl class="grid grid-cols-2 gap-4 <%= hasSchedule ? '' : 'sm:grid-cols-4' %>">
      <% tiles.forEach((tile) => { %>
        <div class="rounded-box bg-base-100 p-4">
          <dt class="text-xs font-semibold text-muted"><%= tile.label %></dt>
          <dd class="mt-1 text-2xl font-bold tabular-nums"><%= tile.value %> <span class="text-sm font-medium text-muted"><%= tile.suffix %></span></dd>
        </div>
      <% }) %>
    </dl>
    <details>
      <summary class="flex min-h-11 cursor-pointer items-center text-sm font-semibold text-primary">How streaks are counted</summary>
      <p class="mt-1 text-sm text-muted">Daily streak counts consecutive calendar days with a check-in. <%= hasSchedule ? 'Scheduled streak counts consecutive due days (or weeks meeting a weekly target); days off do not break it. ' : '' %>Today stays in progress until it ends, so an unchecked today does not break a streak yet. Streaks use the full history; Last 30 days uses only that window.</p>
    </details>

    <section class="rounded-box bg-base-100 p-3 sm:p-5" aria-labelledby="month-heading">
      <div class="flex items-center justify-between gap-2">
        <h2 id="month-heading" class="font-semibold"><%= monthLabel %></h2>
        <div class="flex gap-1">
          <a href="?month=<%= prevMonth %>" class="btn btn-ghost btn-circle size-11" aria-label="Previous month"><%- include('../partials/icon', { icon: 'chevron-left', cls: 'size-4' }) %></a>
          <% if (nextMonth) { %>
            <a href="?month=<%= nextMonth %>" class="btn btn-ghost btn-circle size-11" aria-label="Next month"><%- include('../partials/icon', { icon: 'chevron-right', cls: 'size-4' }) %></a>
          <% } %>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-7 gap-0 text-center text-xs font-semibold text-muted sm:gap-1" aria-hidden="true">
        <% weekdayNames.forEach((name) => { %><span><%= name %></span><% }) %>
      </div>
      <ol class="mt-1 grid grid-cols-7 gap-0 text-center text-sm tabular-nums sm:gap-1">
        <% days.forEach((day) => { %>
          <%
            const circle = `grid size-8 place-items-center rounded-full sm:size-10 ${day.isToday ? 'font-bold outline-2 outline-offset-2 outline-base-content' : ''} ${
              { done: 'text-white', missed: 'border-2 border-base-300', idle: 'text-muted', open: '' }[day.state]}`;
            const fill = day.state === 'done' ? `style="background-color: ${habit.colour}"` : '';
          %>
          <li class="grid place-items-center py-1 <%= day.inMonth ? '' : 'opacity-40' %>">
            <% if (day.editable) { %>
              <%# The last 7 days can be checked in or undone from here %>
              <form method="post" action="/habits/<%= habit._id %>/check-ins" data-fetch="<%= day.date %>">
                <%- include('../partials/csrf') %>
                <input type="hidden" name="date" value="<%= day.date %>">
                <input type="hidden" name="done" value="<%= day.state === 'done' ? '0' : '1' %>">
                <input type="hidden" name="returnTo" value="<%= currentUrl %>">
                <button type="submit" class="<%= circle %> cursor-pointer hover:ring-2 hover:ring-primary" <%- fill %>
                  aria-pressed="<%= day.state === 'done' %>" aria-label="<%= day.state === 'done' ? 'Undo check-in for' : 'Check in for' %> <%= day.label %>"><%= day.number %></button>
              </form>
            <% } else { %>
              <span class="<%= circle %>" <%- fill %>>
                <span aria-hidden="true"><%= day.number %></span><span class="sr-only"><%= day.label %>: <%= stateText[day.state] %></span>
              </span>
            <% } %>
          </li>
        <% }) %>
      </ol>
      <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted" aria-hidden="true">
        <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-full" style="background-color: <%= habit.colour %>"></span>Done</span>
        <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-full border-2 border-base-300"></span>Missed</span>
        <span class="inline-flex items-center gap-1.5"><span class="size-3 rounded-full outline-2 outline-base-content"></span>Today</span>
      </p>
      <p class="mt-1 text-xs text-muted">Forgot one? Tap any of the last 7 days to check it in or undo it.</p>
    </section>
  </div>

  <aside class="space-y-3">
    <a href="/habits/<%= habit._id %>/edit" class="btn h-11 w-full rounded-full border border-base-300 bg-base-100 text-primary">Edit habit</a>
  </aside>
</div>
<%- include('../partials/shell-bottom') %>
