<%- include('_top') %>
<%
  // Links keep the other filter: a chip keeps the search, the search keeps the chip.
  const link = (params) => {
    const query = new URLSearchParams(Object.entries(params).filter(([, value]) => value));
    return `/admin/activity${query.size ? `?${query}` : ''}`;
  };
  const chipClass = (active) =>
    `btn btn-sm h-8 rounded-full px-3.5 font-medium ${active ? 'btn-primary' : 'border-base-300 bg-base-100 font-normal'}`;
%>
<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-bold tracking-tight">Activity log</h1>
    <p class="mt-1 text-sm text-muted">Security events, newest first · kept for <%= retentionDays %> days</p>
  </div>
  <%# data-live-search: public/js/admin.js reloads the chips and results below as you type (Enter still works without JS) %>
  <form method="get" action="/admin/activity" role="search" class="w-full sm:w-80" data-live-search>
    <% if (chip) { %><input type="hidden" name="action" value="<%= chip %>"><% } %>
    <label class="input h-10 w-full rounded-field border-0 bg-fill">
      <%- include('../partials/icon', { icon: 'search', cls: 'size-4 text-muted' }) %>
      <span class="sr-only">Search by email or IP address</span>
      <input type="search" name="q" value="<%= search %>" placeholder="Search by email or IP address" maxlength="100" data-search>
      <kbd class="kbd kbd-sm kbd-hint" title="Press / to search">/</kbd>
    </label>
  </form>
</div>

<nav aria-label="Filter by action" class="mt-5 flex flex-wrap gap-2" data-live="chips">
  <a href="<%= link({ q: search }) %>" class="<%= chipClass(!chip) %>" <% if (!chip) { %>aria-current="page"<% } %>>All actions</a>
  <% filters.forEach((filter) => { %>
    <a href="<%= link({ action: filter.key, q: search }) %>" class="<%= chipClass(chip === filter.key) %>"
      <% if (chip === filter.key) { %>aria-current="page"<% } %>><%= filter.label %></a>
  <% }) %>
</nav>

<p class="sr-only" aria-live="polite" data-live-status></p>
<section class="mt-5 overflow-hidden rounded-box bg-base-100" aria-label="Events" data-live="results">
  <% if (!entries.length) { %>
    <%- include('../partials/empty-state', {
      icon: 'clock',
      heading: search || chip ? 'No matching events' : 'No events yet',
      text: search || chip ? 'Try another filter or search.' : 'Sign-ups, logins and admin actions will appear here.',
    }) %>
  <% } else { %>
    <div class="relative overflow-x-auto" tabindex="0" role="region" aria-label="Activity table, scroll horizontally for more columns">
      <table class="w-full min-w-[760px] text-sm">
        <thead class="bg-base-200/60 text-left text-xs font-semibold tracking-wide text-muted uppercase">
          <tr>
            <th scope="col" class="w-20 px-4 py-3">Time</th>
            <th scope="col" class="px-4 py-3">Action</th>
            <th scope="col" class="px-4 py-3">Account</th>
            <th scope="col" class="px-4 py-3">Details</th>
            <th scope="col" class="px-4 py-3">IP address</th>
          </tr>
        </thead>
        <% days.forEach((day) => { %>
          <tbody class="border-t border-base-300">
            <tr><th scope="rowgroup" colspan="5" class="px-4 pt-3 pb-1 text-left text-xs font-normal text-muted"><%= day.label %></th></tr>
            <% day.entries.forEach((entry, i) => { const action = labels[entry.action] ?? { label: entry.action, tone: 'bg-muted' }; %>
              <tr class="hover:bg-fill <%= i ? 'border-t border-base-300' : '' %>">
                <td class="px-4 py-3 text-muted tabular-nums"><time datetime="<%= entry.createdAt.toISOString() %>"><%= dates.formatTime(entry.createdAt, timeZone) %></time></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full <%= action.tone %>" aria-hidden="true"></span><%= action.label %></span>
                </td>
                <td class="px-4 py-3 font-semibold"><%= entry.email || '—' %></td>
                <td class="px-4 py-3 text-muted"><%= entry.details || '' %></td>
                <td class="px-4 py-3 text-muted tabular-nums"><%= entry.ip || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        <% }) %>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-base-300 px-4 py-3 text-sm text-muted">
      <span>Showing <%= entries.length.toLocaleString('en-US') %> of <%= total.toLocaleString('en-US') %> event<%= total === 1 ? '' : 's' %></span>
      <span class="flex gap-2">
        <% if (cursor) { %>
          <a href="<%= link({ action: chip, q: search }) %>" class="btn btn-sm h-8 rounded-full border-0 bg-fill px-4 text-primary">Newest events</a>
        <% } %>
        <% if (older) { %>
          <a href="<%= link({ action: chip, q: search, before: older }) %>" class="btn btn-sm h-8 rounded-full border-0 bg-fill px-4 text-primary">Load older events</a>
        <% } %>
      </span>
    </div>
  <% } %>
</section>
<%- include('_bottom') %>
