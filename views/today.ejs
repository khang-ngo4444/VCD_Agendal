<%- include('partials/shell-top') %>
<%#
  The Daily List (Figma W01 "Today"). Locals: date, today, week (the strip), heading, eyebrow, progress { done, total, firstName },
  counts, overdue, scheduled, due, habits (summaries due on the day), habitsEditable.
%>
<%
  const { done, total, firstName } = progress;
  const percent = total ? Math.round((done / total) * 100) : 0;
  const cheer = !total ? 'A clear day' : done === total ? 'All done. Well played' : done ? 'Nice pace' : 'Let’s get going';
  const summary = [
    ...(counts.overdue ? [`${counts.overdue} overdue`] : []),
    `${counts.due} task${counts.due === 1 ? '' : 's'} due`,
    `${counts.scheduled} scheduled`,
  ];
%>
<header class="flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="text-xs font-semibold tracking-wide text-primary uppercase"><%= eyebrow %></p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight"><%= heading %></h1>
    <p class="mt-1 text-sm text-muted"><%= summary.join(' · ') %></p>
  </div>
  <form method="get" action="/today" class="flex items-center gap-2">
    <% if (date !== today) { %><a href="/today" class="btn h-11 rounded-full border border-base-300 bg-base-100 px-4 text-primary">Today</a><% } %>
    <label for="pick-date" class="sr-only">Go to date</label>
    <input id="pick-date" name="date" type="date" value="<%= date %>" class="input h-11 w-40 bg-base-100" data-autosubmit>
    <noscript><button type="submit" class="btn h-11 rounded-full">Go</button></noscript>
  </form>
</header>

<div class="mt-6 grid gap-4 md:grid-cols-[minmax(0,320px)_1fr]">
  <section class="flex items-center gap-4 rounded-box bg-base-100 p-5" aria-label="Progress">
    <%# A ring with a grey track (Figma W01), drawn with a conic gradient behind a smaller disc %>
    <div class="grid size-14 shrink-0 place-items-center rounded-full" style="background: conic-gradient(var(--color-success) <%= percent %>%, var(--color-base-300) 0)"
      role="progressbar" aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%= done %> of <%= total %> done">
      <span class="grid size-11 place-items-center rounded-full bg-base-100 text-sm font-semibold tabular-nums"><%= done %>/<%= total %></span>
    </div>
    <div class="min-w-0">
      <p class="font-semibold"><%= cheer %><%= firstName && total ? `, ${firstName}` : '' %>!</p>
      <p class="text-sm text-muted"><%= total ? `${done} of ${total} done` : 'Nothing due or scheduled' %></p>
    </div>
  </section>

  <nav class="flex items-center gap-1 rounded-box bg-base-100 p-3" aria-label="Days of this week">
    <a href="?date=<%= week.previous %>" class="btn btn-ghost btn-circle size-11 shrink-0" aria-label="Previous week"><%- include('partials/icon', { icon: 'chevron-left', cls: 'size-4' }) %></a>
    <ol class="grid grow grid-cols-7 text-center">
      <% week.days.forEach((day) => { %>
        <li>
          <a href="?date=<%= day.date %>" class="group flex flex-col items-center gap-1 rounded-field py-1 text-xs font-semibold text-muted"
            aria-label="<%= day.name %><%= day.busy ? ', has tasks' : '' %>" <% if (day.selected) { %>aria-current="date"<% } %>>
            <span aria-hidden="true"><%= day.letter %></span>
            <span class="grid size-9 place-items-center rounded-full text-base tabular-nums <%= day.selected ? 'bg-primary text-primary-content' : day.isToday ? 'text-primary' : 'text-base-content group-hover:bg-base-200' %>" aria-hidden="true"><%= day.number %></span>
            <span class="size-1 rounded-full <%= day.busy ? 'bg-muted' : '' %>" aria-hidden="true"></span>
          </a>
        </li>
      <% }) %>
    </ol>
    <a href="?date=<%= week.next %>" class="btn btn-ghost btn-circle size-11 shrink-0" aria-label="Next week"><%- include('partials/icon', { icon: 'chevron-right', cls: 'size-4' }) %></a>
  </nav>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-[1fr_340px]">
  <div class="min-w-0 space-y-6">
    <% if (overdue.length) { %>
      <section aria-labelledby="overdue-heading">
        <h2 id="overdue-heading" class="mb-2 font-semibold text-error">Overdue <span><%= overdue.length %></span></h2>
        <ul class="divide-y divide-base-300/60 rounded-box bg-base-100">
          <% overdue.forEach((task) => { %><%- include('tasks/_row', { task, timeZone: currentUser.timeZone, showProject: true }) %><% }) %>
        </ul>
      </section>
    <% } %>
    <section aria-labelledby="tasks-heading">
      <h2 id="tasks-heading" class="mb-2 font-semibold">Tasks <span class="text-muted"><%= due.length %></span></h2>
      <% if (due.length) { %>
        <ul class="divide-y divide-base-300/60 rounded-box bg-base-100">
          <% due.forEach((task) => { %><%- include('tasks/_row', { task, timeZone: currentUser.timeZone, showProject: true }) %><% }) %>
        </ul>
      <% } else { %>
        <div class="rounded-box bg-base-100">
          <%- include('partials/empty-state', { icon: 'check', heading: 'Nothing due', text: 'Tasks due on this day without a set time show up here.' }) %>
        </div>
      <% } %>
    </section>

    <% if (habits.length) { %>
      <section aria-labelledby="habits-heading">
        <h2 id="habits-heading" class="mb-2 font-semibold">Habits <span class="text-muted"><%= habits.filter((summary) => summary.doneOnDate).length %>/<%= habits.length %></span></h2>
        <ul class="divide-y divide-base-300/60 rounded-box bg-base-100">
          <% habits.forEach((summary) => { %><%- include('habits/_row', { summary, date, editable: habitsEditable }) %><% }) %>
        </ul>
      </section>
    <% } %>
  </div>

  <section aria-labelledby="schedule-heading">
    <h2 id="schedule-heading" class="mb-2 font-semibold">Schedule <span class="text-muted"><%= scheduled.length %></span></h2>
    <% if (scheduled.length) { %>
      <ul class="divide-y divide-base-300/60 rounded-box bg-base-100">
        <% scheduled.forEach((task) => { %><%- include('tasks/_row', { task, timeZone: currentUser.timeZone, showProject: true }) %><% }) %>
      </ul>
    <% } else { %>
      <p class="rounded-box bg-base-100 px-4 py-6 text-center text-sm text-muted">Nothing scheduled. Give a task a time to see it here.</p>
    <% } %>
  </section>
</div>
<%- include('partials/shell-bottom') %>
