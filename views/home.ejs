<%- include('partials/header') %>
<%# Public landing page (Figma W15). Sections the cards leave out (AI assistant, offline) are skipped on purpose. %>
<header class="sticky top-0 z-30 border-b border-base-300/60 bg-base-100/80 backdrop-blur">
  <nav aria-label="Main" class="mx-auto flex h-16 max-w-[1120px] items-center gap-8 px-4 lg:h-20">
    <a href="/" class="flex items-center gap-2.5 text-lg font-bold">
      <span class="grid size-8 place-items-center rounded-lg bg-neutral text-neutral-content">
        <%- include('partials/icon', { icon: 'check', cls: 'size-4' }) %>
      </span>
      Agendal
    </a>
    <ul class="flex gap-7 text-sm text-muted">
      <li><a href="#features" class="hover:text-base-content">Features</a></li>
      <li><a href="#how-it-works" class="hover:text-base-content">How it works</a></li>
    </ul>
    <div class="ml-auto flex items-center gap-6">
      <a href="/login" class="text-sm font-semibold text-primary hover:underline">Log in</a>
      <a href="/register" class="btn btn-primary btn-sm h-9 rounded-full px-4">Get started</a>
    </div>
  </nav>
</header>

<main id="main">
  <section class="mx-auto max-w-[680px] px-4 pt-20 pb-24 text-center lg:pt-28">
    <h1 class="text-5xl font-bold leading-[1.05] tracking-tight sm:text-7xl">
      Plan the week.<br><span class="text-muted">Live the day.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-muted">
      Tasks, habits and projects in one calm place — a Kanban board, a calendar and a daily list that always agree with each other.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-6">
      <a href="/register" class="btn btn-primary h-12 rounded-full px-7 text-base">Get started — it’s free</a>
      <a href="#how-it-works" class="font-semibold text-primary hover:underline">See how it works</a>
    </div>
  </section>

  <%
    const features = [
      { icon: 'sun', tint: 'bg-success/15 text-success', name: 'Daily List', text: 'Only what matters now: today’s tasks, your habits and anything overdue.' },
      { icon: 'columns', tint: 'bg-primary/10 text-primary', name: 'Kanban board', text: 'Backlog, Upcoming, Active, Done. See where every project really stands.' },
      { icon: 'calendar', tint: 'bg-warning/15 text-warning', name: 'Calendar', text: 'Drag an unscheduled task onto a free slot. Plan by day, week or month.' },
      { icon: 'repeat', tint: 'bg-primary/10 text-primary', name: 'Habits', text: 'Check in every day, keep your streak going and watch your completion rate.' },
    ];
  %>
  <section id="features" class="mx-auto max-w-[1120px] scroll-mt-20 px-4 py-20" aria-labelledby="features-heading">
    <p class="text-sm font-semibold text-primary">One source of truth</p>
    <h2 id="features-heading" class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">Move a card. Watch the calendar follow.</h2>
    <p class="mt-4 max-w-2xl text-muted">
      Every task lives once. Change it anywhere and the Board, Calendar and Daily List update together — no copying, no conflicts.
    </p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% features.forEach((feature) => { %>
        <li class="rounded-box bg-base-200 p-7">
          <span class="grid size-12 place-items-center rounded-xl <%= feature.tint %>">
            <%- include('partials/icon', { icon: feature.icon, cls: 'size-6' }) %>
          </span>
          <h3 class="mt-6 text-xl font-semibold"><%= feature.name %></h3>
          <p class="mt-2 text-sm text-muted"><%= feature.text %></p>
        </li>
      <% }) %>
    </ul>
  </section>
</main>
<%- include('partials/footer') %>
