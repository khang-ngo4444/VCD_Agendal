PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/agendal

SESSION_SECRET=replace-with-a-secure-secret

# Password `npm run seed` gives admin@agendal.app (the /admin console). Defaults to admin1234 when empty.
ADMIN_PASSWORD=

# Background jobs (the reminder sender) start with the server. Set to false if another process runs them.
JOBS_ENABLED=true

# Leave MAIL_HOST empty to print emails to the console. Mailpit: MAIL_HOST=127.0.0.1, MAIL_PORT=1025
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Agendal <no-reply@agendal.app>

# OAuth sign-in. Leave empty to hide the button. Google: console.cloud.google.com → APIs & Services → Credentials,
# authorised redirect URI = APP_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
