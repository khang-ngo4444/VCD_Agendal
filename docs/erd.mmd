%% Source for docs/erd.png. Re-render after editing:
%% npx -y @mermaid-js/mermaid-cli -i docs/erd.mmd -o docs/erd.png -b white -s 2
erDiagram
    USER ||--o{ PROJECT : owns
    USER ||--o{ TASK : owns
    USER ||--o{ REMINDER : owns
    PROJECT |o--o{ TASK : "groups (none = Inbox)"
    TASK ||--o{ REMINDER : has
    USER ||--o{ HABIT : owns
    HABIT ||--o{ HABIT_CHECK_IN : "has (one per day)"

    USER {
        ObjectId _id PK
        String email UK
        String passwordHash
        String name
        String avatar
        String timeZone
        Object preferences "theme, accentColour, weekStartsOn"
        Object notifications "push, email (on by default), lastEmailAt, emailDay, emailsToday"
        String googleId UK
        Number sessionVersion "bumped to end all sessions"
        Object loginFailures "count, since"
        Date lockedUntil
        Date onboardedAt "null = show Welcome screen"
        Object passwordReset "tokenHash, expiresAt"
        Date createdAt
        Date updatedAt
    }
    PROJECT {
        ObjectId _id PK
        ObjectId owner FK
        String name
        String colour
        Date createdAt
        Date updatedAt
    }
    TASK {
        ObjectId _id PK
        ObjectId owner FK
        ObjectId project FK "null = Inbox"
        String title
        String description
        String priority "low | medium | high"
        Date dueDate
        Object schedule "start, end"
        String status "backlog | upcoming | active | done"
        Number order
        Date completedAt
        Object repeat "frequency, until"
        Date deletedAt "soft delete"
        Date createdAt
        Date updatedAt
    }
    REMINDER {
        ObjectId _id PK
        ObjectId task FK
        ObjectId owner FK
        Date remindAt
        String type "push | email (legacy, not used for routing)"
        Boolean sent "every channel done"
        Date sentAt
        Date pushedAt "push channel claimed / done"
        Date emailedAt "email channel claimed / done"
        Number attempts "failed sends, max 3"
        String lastError
        Date createdAt
        Date updatedAt
    }
    HABIT {
        ObjectId _id PK
        ObjectId owner FK
        String name
        String colour
        Object frequency "type: daily | weekdays | days | timesPerWeek, days, timesPerWeek"
        String reminderTime "HH:mm"
        Date archivedAt
        Date createdAt
        Date updatedAt
    }
    HABIT_CHECK_IN {
        ObjectId _id PK
        ObjectId habit FK
        ObjectId owner FK
        String date "YYYY-MM-DD local, unique with habit"
        Date createdAt
        Date updatedAt
    }
